function ProgressiveEventGrid({ races, onOpen, defer = false }: { races: PublicRace[]; onOpen: (race: PublicRace) => void; defer?: boolean }) {
  const { isSaved, toggleSave } = useSavedRaces();
  const [visibleCount, setVisibleCount] = useState(defer ? 0 : 6);
  const sentinel = useRef<HTMLDivElement | null>(null);

  useEffect(() => setVisibleCount(defer ? 0 : 6), [races, defer]);
  useEffect(() => {
    const node = sentinel.current;
    if (!node || visibleCount >= races.length) return;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) setVisibleCount((count) => Math.min(count + 6, races.length));
    }, { rootMargin: "320px 0px" });
    observer.observe(node);
    return () => observer.disconnect();
  }, [races.length, visibleCount]);

  return <>
    <div className="-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 md:gap-6 lg:grid-cols-3 lg:gap-8">
      {races.slice(0, visibleCount).map((race, index) => <div key={race.id} className="w-[calc(100vw-2.5rem)] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink"><EventCard race={race} index={index} onOpen={onOpen} saved={isSaved(race.id)} onToggleSave={(id) => { void toggleSave(id); }} /></div>)}
      {visibleCount < races.length ? <div ref={sentinel} className="grid h-full min-h-32 w-14 shrink-0 snap-end place-items-center sm:col-span-full sm:h-px sm:min-h-0 sm:w-full" aria-label="Cargando más eventos"><span className="h-7 w-7 animate-spin rounded-full border-2 border-white/15 border-t-[#c9f24b] sm:hidden" /></div> : null}
    </div>
  </>;
}

function normDiscovery(value: string | null | undefined) {
  return String(value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
}

function discoveryScore(race: PublicRace) {
  const reviews = Number(race.review_count) || 0;
  const rating = Number(race.rating_average) || 0;
  const comments = (Number(race.review_comment_count) || 0) + (Number(race.community_comment_count) || 0);
  return (reviews ? rating * 60 : 0) + reviews * 22 + comments * 7 + (Number(race.share_count) || 0) * 10 + (Number(race.save_count) || 0) * 8 + Math.log1p(Number(race.view_count) || 0) * 12;
}

function HomeEventSections({ races, residence, onOpen }: { races: PublicRace[]; residence: string; onOpen: (race: PublicRace) => void }) {
  const best = useMemo(() => [...races].sort((a, b) => Number(!isFinalized(b)) - Number(!isFinalized(a)) || discoveryScore(b) - discoveryScore(a) || (Date.parse(a.event_date || "") || Number.MAX_SAFE_INTEGER) - (Date.parse(b.event_date || "") || Number.MAX_SAFE_INTEGER)).slice(0, 6), [races]);
  const upcoming = useMemo(() => {
    const home = normDiscovery(residence);
    return sortByClosestDate(races.filter((race) => !isFinalized(race))).sort((a, b) => {
      if (!home) return 0;
      const aNear = home.includes(normDiscovery(a.city)) || home.includes(normDiscovery(a.state)) || normDiscovery(placeLabel(a)).includes(home);
      const bNear = home.includes(normDiscovery(b.city)) || home.includes(normDiscovery(b.state)) || normDiscovery(placeLabel(b)).includes(home);
      return Number(bNear) - Number(aNear);
    });
  }, [races, residence]);
  const newest = useMemo(() => [...races].sort((a, b) => Date.parse(b.updated_at || "") - Date.parse(a.updated_at || "")), [races]);
  const sections = [
    { id: "top", title: "Mejores valorados", items: best },
    { id: "near", title: residence ? `Próximos eventos cerca de ti` : "Próximos eventos", items: upcoming },
    { id: "new", title: "Nuevos eventos", items: newest },
  ].filter((section) => section.items.length);
  return <div className="flex flex-col gap-[60px]">{sections.map((section, index) => <section key={section.id} aria-labelledby={`home-${section.id}`}><h2 id={`home-${section.id}`} className="mb-5 text-2xl font-black tracking-[-0.02em] text-white md:mb-6 md:text-3xl">{section.title}</h2><ProgressiveEventGrid races={section.items} onOpen={onOpen} defer={index > 0} /></section>)}</div>;
}

function HomeDirectoryLinks({ races }: { races: PublicRace[] }) {
  const locations = new Map<string, string>(); const categories = new Map<string, string>();
  for (const race of races) {
    const location = race.state || race.city;
    const locationSlug = normDiscovery(location).replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    if (location && locationSlug) locations.set(locationSlug, location);
    const category = String(race.sport_category || "running");
    categories.set(category, category === "running" ? "Running" : category === "trail" ? "Trail running" : category === "triathlon" ? "Triatlón" : category === "cycling" ? "Ciclismo" : category === "swimming" ? "Natación" : category === "walking" ? "Caminata" : category.replace(/(^|-)\w/g, (value) => value.replace("-", " ").toUpperCase()));
  }
  const groups = [
    { title: "Carreras por ubicación", links: [...locations.entries()].map(([slug, label]) => ({ href: `/carreras/${slug}`, label: `Carreras en ${label}` })) },
    { title: "Eventos por disciplina", links: [...categories.entries()].map(([slug, label]) => ({ href: `/carreras/${slug}`, label })) },
    { title: "Buscar por precio", links: [{ href: "/?pmax=0", label: "Eventos gratis" }, { href: "/?pmin=1&pmax=300", label: "Hasta $300" }, { href: "/?pmin=301&pmax=500", label: "$301 a $500" }, { href: "/?pmin=501", label: "Más de $500" }, { href: "/carreras", label: "Todos los eventos" }] },
  ];
  return <nav aria-label="Directorio de carreras" className="mt-20 border-t border-white/10 pt-10"><h2 className="text-2xl font-black text-white">Explora más carreras</h2><p className="mt-2 text-sm text-white/50">Encuentra eventos por ciudad, disciplina y rango de precio.</p><div className="mt-8 grid gap-8 md:grid-cols-3">{groups.map((group) => <section key={group.title}><h3 className="text-xs font-bold uppercase tracking-[0.14em] text-white/40">{group.title}</h3><div className="mt-4 flex flex-wrap gap-2">{group.links.map((link) => <a key={link.href} href={link.href} className="rounded-full border border-white/12 bg-white/[0.04] px-4 py-2 text-sm font-semibold text-white/75 transition hover:border-[#c9f24b] hover:text-[#c9f24b]">{link.label}</a>)}</div></section>)}</div></nav>;
}

type UserResult = { user_id: string; username: string; display_name: string; avatar_url?: string | null; bio?: string | null };

function UserSearchResults({ query }: { query: string }) {
  const [people, setPeople] = useState<UserResult[]>([]);
  useEffect(() => {
    let active = true;
    if (query.trim().length < 2) { setPeople([]); return; }
    import("@/lib/supabase/client").then(({ createClient }) => createClient().rpc("public_user_search", { p_query: query.trim(), p_limit: 12 })).then(({ data }) => { if (active) setPeople(Array.isArray(data) ? data as UserResult[] : []); });
    return () => { active = false; };
  }, [query]);
  if (!people.length) return null;
  return <section className="mb-7"><h2 className="mb-3 text-sm font-semibold text-white/50">Personas</h2><div className="space-y-1">{people.map((person) => <a key={person.user_id} href={`/perfil/${person.username}`} className="flex items-center gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-white/[0.06]">{person.avatar_url ? /* eslint-disable-next-line @next/next/no-img-element */ <img src={person.avatar_url} alt="" className="h-12 w-12 rounded-full object-cover" /> : <span className="grid h-12 w-12 place-items-center rounded-full bg-white/10 font-bold">{person.display_name.slice(0, 1)}</span>}<span className="min-w-0"><strong className="block truncate text-sm text-white">{person.display_name}</strong><span className="block truncate text-xs text-white/45">@{person.username}</span></span></a>)}</div></section>;
}

function CompactEventCard({ race, onOpen }: { race: PublicRace; onOpen: (race: PublicRace) => void }) {
  const image = cardCoverImage(race);
  const [loaded, setLoaded] = useState(!image);
  return <a href={marketplaceEventUrl(race)} onClick={(event) => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); onOpen(race); }} className="flex w-full items-center gap-3 rounded-2xl p-2 text-left transition-colors hover:bg-white/[0.06]">
    <span className="relative h-20 w-16 shrink-0 overflow-hidden rounded-xl bg-white/[0.05]">{image ? <>{!loaded ? <span className="absolute inset-0 grid place-items-center"><span className="h-5 w-5 animate-spin rounded-full border-2 border-white/20 border-t-[#c9f24b]" /></span> : null}{/* eslint-disable-next-line @next/next/no-img-element */}<img src={image} alt="" onLoad={() => setLoaded(true)} className={`h-full w-full object-cover ${loaded ? "opacity-100" : "opacity-0"}`} /></> : null}</span>
    <span className="min-w-0"><strong className="line-clamp-2 text-sm text-white">{race.name}</strong><span className="mt-1 block truncate text-xs text-white/45">{formatDateTime(race.event_date).date}</span></span>
  </a>;
}

export default function ExploreView({
  races,
  q = "",
  seoHub,
}: {
  races: PublicRace[];
  status?: string;
  q?: string;
  counts?: { all: number; active: number; inactive: number };
  seoHub?: SeoHubContent;
}) {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();
  const { filtersOpen, closeFilters } = useMarketplaceSearch();
  const [filter, setFilter] = useState<FilterTab>("eventos");
  const [hubFilter, setHubFilter] = useState<HubFilter>("upcoming");
  const { user: notificationUser } = useAthleteAuth();
  const [residence, setResidence] = useState("");
  const [notifications, setNotifications] = useState<SocialNotification[]>([]);
  const [notificationCount, setNotificationCount] = useState(0);
  const [notificationLoading, setNotificationLoading] = useState(false);
  const [notificationError, setNotificationError] = useState(false);
  const [activityRefresh, setActivityRefresh] = useState(0);

  useEffect(() => {
    let active = true;
    if (!notificationUser?.id) { setResidence(""); return; }
    void createClient().from("athlete_profiles").select("residence").eq("user_id", notificationUser.id).maybeSingle().then(({ data }) => {
      if (active) setResidence(String(data?.residence || ""));
    });
    return () => { active = false; };
  }, [notificationUser?.id]);

  const refreshNotifications = useCallback(async () => {
    if (!notificationUser) {
      setNotifications([]);
      setNotificationCount(0);
      return;
    }
    const { data, error } = await createClient().rpc("my_social_notifications", { p_limit: 50 });
    setNotificationError(Boolean(error));
    if (!error && data && typeof data === "object") {
      const result = data as { items?: SocialNotification[]; unread_count?: number };
      setNotifications(Array.isArray(result.items) ? result.items : []);
      setNotificationCount(Number(result.unread_count) || 0);
    }
    setNotificationLoading(false);
  }, [notificationUser?.id]);

  useEffect(() => {
    if (notificationUser) setNotificationLoading(true);
    void refreshNotifications();
    const timer = window.setInterval(() => void refreshNotifications(), 20000);
    window.addEventListener("focus", refreshNotifications);
    window.addEventListener("dorsalia:social-updated", refreshNotifications);
    return () => {
      window.clearInterval(timer);
      window.removeEventListener("focus", refreshNotifications);
      window.removeEventListener("dorsalia:social-updated", refreshNotifications);
    };
  }, [refreshNotifications, notificationUser?.id]);

  useEffect(() => {
    if (filter !== "actividad" || !notificationUser) return;
    void (async () => {
      await createClient().rpc("mark_social_notifications_read");
      await refreshNotifications();
    })();
  }, [filter, notificationUser?.id, refreshNotifications]);

  useEffect(() => {
    const refresh = () => { setActivityRefresh((value) => value + 1); setFilter("para_ti"); };
    window.addEventListener("dorsalia:activity-published", refresh);
    return () => window.removeEventListener("dorsalia:activity-published", refresh);
  }, []);

  const searchFilters = useMemo(
    () => filtersFromSearchParams(new URLSearchParams(searchParams.toString())),
    [searchParams],
  );
  const cities = useMemo(() => uniqueCities(races), [races]);
  const bounds = useMemo(() => priceBounds(races), [races]);
  const filtered = useMemo(
    () => filterRaces(races, searchFilters),
    [races, searchFilters],
  );
  const hubFiltered = useMemo(() => {
    if (!seoHub || hubFilter === "all") return filtered;
    const now = Date.now();
    const finished = (race: PublicRace) => isFinalized(race) || Boolean(race.event_date && Date.parse(race.event_date) < now);
    if (hubFilter === "finished") return filtered.filter(finished);
    if (hubFilter === "free") return filtered.filter((race) => !finished(race) && isEventFree(race));
    if (hubFilter === "paid") return filtered.filter((race) => !finished(race) && !isEventFree(race) && minPrice(race) > 0);
    return filtered.filter((race) => !finished(race));
  }, [filtered, hubFilter, seoHub]);
  const ordered = useMemo(() => sortByFilter(hubFiltered), [hubFiltered]);
  const hasSearch =
    Boolean(searchFilters.q) || countActiveFilters(searchFilters) > 0;

  function openRace(race: PublicRace) {
    router.push(marketplaceEventUrl(race));
  }

  return (
    <div className="relative min-h-screen bg-[#070707] mp-page-enter">
      <section className="relative z-10 px-5 pb-16 pt-[30px]">
        <SearchFiltersSheet
          open={filtersOpen}
          onClose={closeFilters}
          cities={cities}
          boundMin={bounds.min}
          boundMax={bounds.max}
        />

        {seoHub ? <SeoHubHero content={seoHub} /> : <a
          href="/iniciar"
          className="mb-[30px] block overflow-hidden rounded-[28px]"
          aria-label={BANNER_ALT}
        >
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={BANNER_MOBILE}
            alt={BANNER_ALT}
            width={1080}
            height={1011}
            className="h-auto w-full md:hidden"
            decoding="async"
            fetchPriority="high"
          />
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={BANNER_DESK}
            alt={BANNER_ALT}
            width={3021}
            height={900}
            className="hidden h-auto w-full md:block"
            decoding="async"
            fetchPriority="high"
          />
        </a>}

        <div className="mb-[30px] md:hidden">
          <button type="button" onClick={() => router.push("/buscar")} className="h-[48px] w-full rounded-[24px] border border-white/15 bg-white/[0.04] px-5 text-left text-[16px] text-white/45">Buscar eventos o usuarios…</button>
        </div>

        <div className="mb-[30px] md:mb-10">
          {seoHub ? <HubFilterButtons active={hubFilter} onChange={setHubFilter} /> : <FilterButtons active={filter} onChange={setFilter} unreadCount={notificationCount} />}
        </div>

        {!seoHub && filter === "actividad" ? (
          <div className="w-[calc(100%+2.5rem)] -translate-x-5 md:mx-auto md:w-full md:max-w-2xl md:translate-x-0"><SocialNotifications items={notifications} loading={notificationLoading} error={notificationError} signedIn={Boolean(notificationUser)} /></div>
        ) : !seoHub && filter === "para_ti" ? (
          <div className="w-[calc(100%+2.5rem)] -translate-x-5 md:mx-auto md:w-full md:max-w-2xl md:translate-x-0"><ActivityFeed followingOnly refreshKey={activityRefresh} emptyText="Sigue personas para ver sus publicaciones aquí." /></div>
        ) : hasSearch ? (
          <div className="mx-auto max-w-2xl">
            <UserSearchResults query={searchFilters.q || ""} />
            <h2 className="mb-3 text-sm font-semibold text-white/50">Eventos</h2>
            {ordered.length ? <div className="space-y-1">{ordered.map((race) => <CompactEventCard key={race.id} race={race} onOpen={openRace} />)}</div> : <p className="px-3 py-8 text-sm text-white/40">No encontramos eventos con esa búsqueda.</p>}
          </div>
        ) : ordered.length === 0 ? (
          <div className="rounded-2xl border border-dashed border-white/15 px-6 py-16 text-center">
            <p className="font-akira text-lg">
              {hasSearch ? "Sin resultados" : "Aún no hay carreras publicadas"}
            </p>
            <p className="mt-2 text-sm text-white/55">
              {hasSearch
                ? "Prueba otra búsqueda o ajusta los filtros."
                : "Cuando un organizador publique su evento, aparecerá aquí."}
            </p>
          </div>
        ) : seoHub ? (
          <ProgressiveEventGrid races={ordered} onOpen={openRace} />
        ) : (
          <HomeEventSections races={ordered} residence={residence} onOpen={openRace} />
        )}

        {seoHub ? (
          <section className="mt-16 border-t border-white/10 pt-10">
            <div className="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.55fr)]">
              <div><h2 className="text-2xl font-black text-white">Encuentra tu próximo evento</h2><p className="mt-4 max-w-3xl text-pretty text-sm leading-7 text-white/55 md:text-base">{seoHub.longDescription}</p></div>
              {seoHub.relatedLinks.length ? <div><h2 className="text-sm font-bold uppercase tracking-[0.14em] text-white/45">Explorar también</h2><div className="mt-4 flex flex-wrap gap-2">{seoHub.relatedLinks.map((link) => <a key={link.href} href={link.href} className="rounded-full border border-white/12 bg-white/[0.04] px-4 py-2 text-sm font-semibold text-white/80 transition hover:border-[#c9f24b] hover:text-[#c9f24b]">{link.label}</a>)}</div></div> : null}
            </div>
          </section>
        ) : filter === "eventos" && !hasSearch ? <HomeDirectoryLinks races={races} /> : null}
      </section>
    </div>
  );
}

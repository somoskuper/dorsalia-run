function useDebouncedQuerySync(value: string, delayMs = 280) {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();
  const timer = useRef<number | null>(null);
  const skipFirst = useRef(true);

  useEffect(() => {
    if (skipFirst.current) {
      skipFirst.current = false;
      return;
    }
    if (timer.current) window.clearTimeout(timer.current);
    timer.current = window.setTimeout(() => {
      const current = (searchParams.get("q") || "").trim();
      if (current === value.trim()) return;
      const base = filtersFromSearchParams(new URLSearchParams(searchParams.toString()));
      const params = writeFiltersToSearchParams(new URLSearchParams(searchParams.toString()), {
        ...base,
        q: value.trim(),
      });
      const e = searchParams.get("e");
      if (e) params.set("e", e);
      const status = searchParams.get("status");
      if (status) params.set("status", status);
      const qs = params.toString();
      router.replace(qs ? `${pathname}?${qs}` : pathname, { scroll: false });
    }, delayMs);
    return () => {
      if (timer.current) window.clearTimeout(timer.current);
    };
  }, [value, delayMs, pathname, router, searchParams]);
}

function MobileSearch({ initialQ }: { initialQ: string }) {
  const { toggleFilters } = useMarketplaceSearch();
  const searchParams = useSearchParams();
  const urlQ = searchParams.get("q") || "";
  const [value, setValue] = useState(initialQ || urlQ);
  const activeCount = countActiveFilters(
    filtersFromSearchParams(new URLSearchParams(searchParams.toString())),

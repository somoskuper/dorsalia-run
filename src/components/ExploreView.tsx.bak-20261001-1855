function EventCard({
  race,
  onOpen,
  saved,
  onToggleSave,
  index = 0,
}: {
  race: PublicRace;
  onOpen: (race: PublicRace) => void;
  saved: boolean;
  onToggleSave: (id: string) => void;
  index?: number;
}) {
  const img = cardCoverImage(race);
  const { user } = useAthleteAuth();
  const imageRef = useRef<HTMLImageElement | null>(null);
  const [imageLoaded, setImageLoaded] = useState(!img);
  const { date, time } = formatDateTime(race.event_date);
  const dateLabel = [date, time].filter(Boolean).join(", ");
  const done = isFinalized(race);
  const badgeLabel = done ? "Finalizado" : formatMinPrice(race);
  const place = placeLabel(race);

  useEffect(() => {
    setImageLoaded(!img);
    const frame = window.requestAnimationFrame(() => {
      if (imageRef.current?.complete && imageRef.current.naturalWidth > 0) setImageLoaded(true);
    });
    return () => window.cancelAnimationFrame(frame);
  }, [img]);

  async function share(e: React.MouseEvent) {
    e.preventDefault();
    e.stopPropagation();
    const url = marketplaceEventUrl(race);
    if (!url) return;
    if (user) {
      window.dispatchEvent(new CustomEvent("dorsalia:create-post", { detail: { id: race.id, name: race.name, slug: billboardSlug(race), cover: img } }));
      return;
    }
    try {
      if (navigator.share) {
        await navigator.share({ title: race.name, text: race.name, url });
        return;
      }
    } catch {
      /* user cancelled or unsupported */
    }
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      /* ignore */
    }
  }

  return (
    <div
      className="group mp-card mp-rise-in w-full text-left"
      style={{ animationDelay: `${Math.min(index, 12) * 45}ms` }}
    >
      <div className="mb-3 flex h-[29px] items-center gap-2">
        {organizerImage(race) ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img
            src={organizerImage(race)!}
            alt=""
            width={29}
            height={29}
            className="h-[29px] w-[29px] shrink-0 rounded-full object-cover"
          />
        ) : (
          <span className="grid h-[29px] w-[29px] shrink-0 place-items-center rounded-full bg-white/10 text-[10px] font-semibold text-white/50">
            {organizerLabel(race).slice(0, 1).toUpperCase()}
          </span>
        )}

        <div className="flex h-[29px] min-w-0 flex-1 flex-col justify-center">
          <p className="truncate text-[16px] leading-[16px] text-white">
            {organizerLabel(race)}
          </p>
          {place ? (
            <p className="mt-[3px] truncate text-[10px] leading-[10px] text-white/50">
              {place}
            </p>
          ) : null}
        </div>

        <div className="flex h-[29px] shrink-0 items-center" style={{ gap: 7 }}>
          <button
            type="button"
            onClick={(e) => {
              e.preventDefault();
              e.stopPropagation();
              onToggleSave(race.id);
            }}
            className={`grid h-[29px] w-[29px] place-items-center transition-opacity hover:opacity-100 ${
              saved ? "opacity-100" : "opacity-50"
            }`}
            aria-label={saved ? `Quitar ${race.name} de guardados` : `Guardar ${race.name}`}
            aria-pressed={saved}
          >
            {/* eslint-disable-next-line @next/next/no-img-element */}
            <img
              src={ICON_SAVED}
              alt=""
              width={29}
              height={29}
              className="h-[29px] w-[29px]"
              style={
                saved
                  ? { filter: "brightness(0) saturate(100%) invert(89%) sepia(64%) saturate(548%) hue-rotate(18deg) brightness(103%) contrast(101%)" }
                  : undefined
              }
            />
          </button>
          <button
            type="button"
            onClick={share}
            className="grid h-[29px] w-[29px] place-items-center opacity-50 transition-opacity hover:opacity-80"
            aria-label={`Compartir ${race.name}`}
          >
            {/* eslint-disable-next-line @next/next/no-img-element */}
            <img src={ICON_SHARE} alt="" width={29} height={29} className="h-[29px] w-[29px]" />
          </button>
        </div>
      </div>

      <a href={marketplaceEventUrl(race)} onClick={(event) => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); onOpen(race); }} className="block w-full text-left">
        <div className="mp-card-poster">
          {img ? (
            <>
              {!imageLoaded ? <div className="absolute inset-0 z-[2] grid place-items-center" role="status" aria-label="Cargando portada"><span className="h-9 w-9 animate-spin rounded-full border-2 border-white/20 border-t-[#c9f24b]" /></div> : null}
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img
                ref={imageRef}
                src={img}
                alt={race.name}
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                fetchPriority={index === 0 ? "high" : "auto"}
                onLoad={() => setImageLoaded(true)}
                className={`absolute inset-0 h-full w-full object-cover transition-[opacity,transform] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05] ${imageLoaded ? "opacity-100" : "opacity-0"}`}
              />
            </>
          ) : (
            <div className="absolute inset-0 grid place-items-center px-6 text-center font-akira text-white/30">
              {race.name}
            </div>
          )}

          <div className="absolute z-10" style={{ top: 15, right: 15 }}>
            <span className="mp-card-badge block whitespace-nowrap px-[10px] py-[5px] text-[10px] font-bold uppercase tracking-[0.08em] text-white">
              {badgeLabel}
            </span>
          </div>

          <div
            className="mp-card-info-glass absolute bottom-[15px] left-[15px] right-[15px] z-10 p-[15px]"
          >
            <h2 className="mp-card-title font-akira text-[20px] leading-[1.1] text-white line-clamp-2">
              {race.name}
            </h2>
            <p className="mp-card-meta mt-2 flex items-center gap-1.5 text-[12px] leading-none text-white/90">
              <CalendarIcon />
              <span className="truncate">{dateLabel}</span>
            </p>
          </div>
        </div>
      </a>
    </div>
  );
}

type UserResult = { user_id: string; username: string; display_name: string; avatar_url?: string | null; bio?: string | null };

function UserSearchResults({ query }: { query: string }) {
  const [people, setPeople] = useState<UserResult[]>([]);
  useEffect(() => {
    let active = true;
    if (query.trim().length < 2) { setPeople([]); return; }
    import("@/lib/supabase/client").then(({ createClient }) => createClient().rpc("public_user_search", { p_query: query.trim(), p_limit: 12 })).then(({ data }) => { if (active) setPeople(Array.isArray(data) ? data as UserResult[] : []); });
    return () => { active = false; };
  }, [query]);
  if (!people.length) return null;
  return <section className="mb-7"><h2 className="mb-3 text-sm font-semibold text-white/50">Personas</h2><div className="space-y-1">{people.map((person) => <a key={person.user_id} href={`/perfil/${person.username}`} className="flex items-center gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-white/[0.06]">{person.avatar_url ? /* eslint-disable-next-line @next/next/no-img-element */ <img src={person.avatar_url} alt="" className="h-12 w-12 rounded-full object-cover" /> : <span className="grid h-12 w-12 place-items-center rounded-full bg-white/10 font-bold">{person.display_name.slice(0, 1)}</span>}<span className="min-w-0"><strong className="block truncate text-sm text-white">{person.display_name}</strong><span className="block truncate text-xs text-white/45">@{person.username}</span></span></a>)}</div></section>;
}

function CompactEventCard({ race, onOpen }: { race: PublicRace; onOpen: (race: PublicRace) => void }) {
  const image = cardCoverImage(race);
  const [loaded, setLoaded] = useState(!image);
  return <a href={marketplaceEventUrl(race)} onClick={(event) => { if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return; event.preventDefault(); onOpen(race); }} className="flex w-full items-center gap-3 rounded-2xl p-2 text-left transition-colors hover:bg-white/[0.06]">
    <span className="relative h-20 w-16 shrink-0 overflow-hidden rounded-xl bg-white/[0.05]">{image ? <>{!loaded ? <span className="absolute inset-0 grid place-items-center"><span className="h-5 w-5 animate-spin rounded-full border-2 border-white/20 border-t-[#c9f24b]" /></span> : null}{/* eslint-disable-next-line @next/next/no-img-element */}<img src={image} alt="" onLoad={() => setLoaded(true)} className={`h-full w-full object-cover ${loaded ? "opacity-100" : "opacity-0"}`} /></> : null}</span>
    <span className="min-w-0"><strong className="line-clamp-2 text-sm text-white">{race.name}</strong><span className="mt-1 block truncate text-xs text-white/45">{formatDateTime(race.event_date).date}</span></span>
  </a>;
}

export default function ExploreView({
  races,
  q = "",
}: {
  races: PublicRace[];
  status?: string;
  q?: string;
  counts?: { all: number; active: number; inactive: number };
}) {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();
  const { filtersOpen, closeFilters } = useMarketplaceSearch();
  const { isSaved, toggleSave } = useSavedRaces();
  const [filter, setFilter] = useState<FilterTab>("eventos");
  const { user: notificationUser } = useAthleteAuth();
  const [notifications, setNotifications] = useState<SocialNotification[]>([]);
  const [notificationCount, setNotificationCount] = useState(0);
  const [notificationLoading, setNotificationLoading] = useState(false);
  const [notificationError, setNotificationError] = useState(false);
  const [activityRefresh, setActivityRefresh] = useState(0);

  const refreshNotifications = useCallback(async () => {
    if (!notificationUser) {
      setNotifications([]);
      setNotificationCount(0);
      return;
    }
    const { data, error } = await createClient().rpc("my_social_notifications", { p_limit: 50 });
    setNotificationError(Boolean(error));
    if (!error && data && typeof data === "object") {
      const result = data as { items?: SocialNotification[]; unread_count?: number };
      setNotifications(Array.isArray(result.items) ? result.items : []);
      setNotificationCount(Number(result.unread_count) || 0);
    }
    setNotificationLoading(false);
  }, [notificationUser?.id]);

  useEffect(() => {
    if (notificationUser) setNotificationLoading(true);
    void refreshNotifications();
    const timer = window.setInterval(() => void refreshNotifications(), 20000);
    window.addEventListener("focus", refreshNotifications);
    window.addEventListener("dorsalia:social-updated", refreshNotifications);
    return () => {
      window.clearInterval(timer);
      window.removeEventListener("focus", refreshNotifications);
      window.removeEventListener("dorsalia:social-updated", refreshNotifications);
    };
  }, [refreshNotifications, notificationUser?.id]);

  useEffect(() => {
    if (filter !== "actividad" || !notificationUser) return;
    void (async () => {
      await createClient().rpc("mark_social_notifications_read");
      await refreshNotifications();
    })();
  }, [filter, notificationUser?.id, refreshNotifications]);

  useEffect(() => {
    const refresh = () => { setActivityRefresh((value) => value + 1); setFilter("para_ti"); };
    window.addEventListener("dorsalia:activity-published", refresh);
    return () => window.removeEventListener("dorsalia:activity-published", refresh);
  }, []);

  const searchFilters = useMemo(
    () => filtersFromSearchParams(new URLSearchParams(searchParams.toString())),
    [searchParams],
  );
  const cities = useMemo(() => uniqueCities(races), [races]);
  const bounds = useMemo(() => priceBounds(races), [races]);
  const filtered = useMemo(
    () => filterRaces(races, searchFilters),
    [races, searchFilters],
  );
  const ordered = useMemo(() => sortByFilter(filtered), [filtered]);
  const hasSearch =
    Boolean(searchFilters.q) || countActiveFilters(searchFilters) > 0;

  function openRace(race: PublicRace) {
    router.push(marketplaceEventUrl(race));
  }

  return (
    <div className="relative min-h-screen bg-[#070707] mp-page-enter">
      <section className="relative z-10 px-5 pb-16 pt-[30px]">
        <SearchFiltersSheet
          open={filtersOpen}
          onClose={closeFilters}
          cities={cities}
          boundMin={bounds.min}
          boundMax={bounds.max}
        />

        <a
          href="/iniciar"
          className="mb-[30px] block overflow-hidden rounded-[28px]"
          aria-label={BANNER_ALT}
        >
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={BANNER_MOBILE}
            alt={BANNER_ALT}
            width={1080}
            height={1011}
            className="h-auto w-full md:hidden"
            decoding="async"
            fetchPriority="high"
          />
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={BANNER_DESK}
            alt={BANNER_ALT}
            width={3021}
            height={900}
            className="hidden h-auto w-full md:block"
            decoding="async"
            fetchPriority="high"
          />
        </a>

        <div className="mb-[30px] md:hidden">
          <button type="button" onClick={() => router.push("/buscar")} className="h-[48px] w-full rounded-[24px] border border-white/15 bg-white/[0.04] px-5 text-left text-[16px] text-white/45">Buscar eventos o usuarios…</button>
        </div>

        <div className="mb-[30px] md:mb-10">
          <FilterButtons active={filter} onChange={setFilter} unreadCount={notificationCount} />
        </div>

        {filter === "actividad" ? (
          <div className="w-[calc(100%+2.5rem)] -translate-x-5 md:mx-auto md:w-full md:max-w-2xl md:translate-x-0"><SocialNotifications items={notifications} loading={notificationLoading} error={notificationError} signedIn={Boolean(notificationUser)} /></div>
        ) : filter === "para_ti" ? (
          <div className="w-[calc(100%+2.5rem)] -translate-x-5 md:mx-auto md:w-full md:max-w-2xl md:translate-x-0"><ActivityFeed followingOnly refreshKey={activityRefresh} emptyText="Sigue personas para ver sus publicaciones aquí." /></div>
        ) : hasSearch ? (
          <div className="mx-auto max-w-2xl">
            <UserSearchResults query={searchFilters.q || ""} />
            <h2 className="mb-3 text-sm font-semibold text-white/50">Eventos</h2>
            {ordered.length ? <div className="space-y-1">{ordered.map((race) => <CompactEventCard key={race.id} race={race} onOpen={openRace} />)}</div> : <p className="px-3 py-8 text-sm text-white/40">No encontramos eventos con esa búsqueda.</p>}
          </div>
        ) : ordered.length === 0 ? (
          <div className="rounded-2xl border border-dashed border-white/15 px-6 py-16 text-center">
            <p className="font-akira text-lg">
              {hasSearch ? "Sin resultados" : "Aún no hay carreras publicadas"}
            </p>
            <p className="mt-2 text-sm text-white/55">
              {hasSearch
                ? "Prueba otra búsqueda o ajusta los filtros."
                : "Cuando un organizador publique su evento, aparecerá aquí."}
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-8">
            {ordered.map((race, index) => (
              <EventCard
                key={race.id}
                race={race}
                index={index}
                onOpen={openRace}
                saved={isSaved(race.id)}
                onToggleSave={(id) => {
                  void toggleSave(id);
                }}
              />
            ))}
          </div>
        )}
      </section>
    </div>
  );
}

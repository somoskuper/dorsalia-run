import type { MarketplaceAdCard as Ad } from "@/lib/marketplaceAds";

export default function MarketplaceAdCard({ ad, variant = "card" }: { ad: Ad; variant?: "card" | "hero" }) {
  const href = /^(https?:\/\/|\/(?!\/))/i.test(ad.cta_url) ? ad.cta_url : "#";
  if (variant === "hero") return (
    <header className="flex aspect-[4/5] w-full flex-col overflow-hidden rounded-[28px] text-black" style={{ backgroundColor: ad.background_color, containerType: "inline-size" }}>
      {ad.image_url ? <div className="relative h-[25%] shrink-0 overflow-hidden bg-black/10">
        {/* eslint-disable-next-line @next/next/no-img-element */}
        <img src={ad.image_url} alt={ad.image_alt || ""} fetchPriority="high" className="h-full w-full object-cover object-center" />
      </div> : null}
      <div className="flex min-h-0 flex-1 flex-col px-[8%] pb-[6%] pt-[6%]">
        <p className="text-[clamp(0.65rem,2.8cqw,0.75rem)] font-extrabold uppercase tracking-[0.14em] text-black/65">{ad.footer_primary || "Dorsalia.run · México"}</p>
        <h1 className="mt-2 text-balance text-[clamp(1.45rem,6.4cqw,2rem)] font-black leading-[1.06] tracking-[-0.04em]">{ad.title}</h1>
        {ad.description ? <p className="mt-2 text-pretty text-[clamp(0.8rem,3.4cqw,0.96rem)] leading-[1.4] text-black/70">{ad.description}</p> : null}
        <div className="mt-auto flex items-end justify-between gap-2 pt-3">
          <p className="min-w-0 text-[clamp(0.72rem,3cqw,0.85rem)] font-medium leading-snug text-black/60">{ad.footer_secondary}</p>
          {ad.cta_label && href !== "#" ? <a href={href} style={{ color: "#fff" }} className="shrink-0 rounded-[16px] bg-[#121212] px-4 py-3 text-[clamp(0.8rem,3.5cqw,0.95rem)] font-bold transition hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">{ad.cta_label}</a> : null}
        </div>
      </div>
    </header>
  );
  return (
    <article className="w-full" style={{ containerType: "inline-size" }}>
      <div className="flex aspect-[4/5] flex-col overflow-hidden rounded-[28px] text-black" style={{ backgroundColor: ad.background_color }}>
        {ad.image_url ? <div className="relative h-1/2 shrink-0 overflow-hidden bg-black/10">
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img src={ad.image_url} alt={ad.image_alt || ad.title} loading="lazy" className="h-full w-full object-cover object-bottom" />
        </div> : null}
        <div className="flex min-h-0 flex-1 flex-col justify-between">
          <div className="min-h-0 px-[8%] pt-[7%]">
            <h2 className="line-clamp-3 text-[clamp(1.35rem,7cqw,2.25rem)] font-bold leading-[1.08] tracking-[-0.03em]">{ad.title}</h2>
            {ad.description ? <p className="mt-2 line-clamp-2 text-[clamp(0.9rem,4cqw,1.25rem)] leading-snug text-black/55">{ad.description}</p> : null}
          </div>
          <div className="flex items-end justify-between gap-2 border-t border-black/10 px-[8%] py-[5%]">
            <div className="min-w-0 text-[clamp(0.75rem,3.5cqw,1rem)] leading-snug text-black/60">
              <p className="truncate font-semibold">{ad.footer_primary}</p>
              <p className="truncate">{ad.footer_secondary}</p>
            </div>
            {ad.cta_label && href !== "#" ? <a href={href} style={{ color: "#fff" }} className="shrink-0 rounded-[18px] bg-[#121212] px-[5%] py-[4%] text-center text-[clamp(0.85rem,4.3cqw,1.25rem)] font-bold transition hover:bg-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">{ad.cta_label}</a> : null}
          </div>
        </div>
      </div>
    </article>
  );
}

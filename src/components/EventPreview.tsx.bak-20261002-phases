"use client";

import dynamic from "next/dynamic";
import Link from "next/link";
import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { createPortal } from "react-dom";
import type { PublicRace } from "@/lib/races";
import {
  billboardSlug,
  marketplaceEventUrl,
  cardCoverImage,
  coverImage,
  eventSiteUrl,
  flyerImage,
  formatDateTime,
  isEventFree,
  isFinalized,
  organizerImage,
  organizerLabel,
  organizerSlugFrom,
  placeLabel,
  seoDescription,
  simplifiedPricingPhases,
} from "@/lib/races";
import { formatDistance, routeTrace, type PublicEventRoute } from "@/lib/routeMap";
import GlassIconButton from "@/components/account/GlassIconButton";
import { useSavedRaces } from "@/components/SavedRacesProvider";
import Button from "@/components/ui/Button";
import GlassPanel from "@/components/ui/GlassPanel";
import EventReviews, { EventRatingSummary } from "@/components/reviews/EventReviews";
import EventMetrics, { type EventMetricSnapshot } from "@/components/EventMetrics";
import PublicGalleryCarousel from "@/components/PublicGalleryCarousel";
import RichEventText from "@/components/RichEventText";
import EventCommunityQuestions from "@/components/community/EventCommunityQuestions";
import SiteFooter from "@/components/SiteFooter";
import {
  EMPTY_EVENT_REVIEWS,
  fetchEventReviews,
  type EventReviewData,
} from "@/lib/eventReviews";
import { createEventShareCard } from "@/lib/eventShareCard";

const ICON_BACK = "/assetsdev/Chevron_Right.svg";
const ICON_SHARE = "/branding/compartir-icon.svg";
const ICON_HELP = "/assetsdev/Circle_Help.svg";

const SOCIAL_ICONS: Record<string, string> = {
  whatsapp: "/assetsdev/Social-Icons.svg",
  x: "/assetsdev/Social-Icons-1.svg",
  youtube: "/assetsdev/Social-Icons-2.svg",
  tiktok: "/assetsdev/Social-Icons-3.svg",
  facebook: "/assetsdev/Social-Icons-4.svg",
  instagram: "/assetsdev/Social-Icons-5.svg",
};

const AnimatedRouteMap = dynamic(() => import("@/components/AnimatedRouteMap"), { ssr: false });

const CLOSE_MS = 190;
const METRICS_API = `${(process.env.NEXT_PUBLIC_PORTAL_URL || "https://portal.dorsalia.run").replace(/\/$/, "")}/sites/v1/public-event-metrics`;

export default function EventPreview({
  race,
  onClose,
  standalone = false,
}: {
  race: PublicRace;
  onClose?: () => void;
  standalone?: boolean;
}) {
  const [showForm, setShowForm] = useState(false);
  const [mainImageLoaded, setMainImageLoaded] = useState(false);
  const [registroImmersive, setRegistroImmersive] = useState(false);
  const [aboutExpanded, setAboutExpanded] = useState(false);
  const [state, setState] = useState<"open" | "closing">("open");
  const closingRef = useRef(false);
  const mainImageRef = useRef<HTMLImageElement | null>(null);
  /** Portada de cartelera (misma que cards); flyer solo si no hay portada. */
  const cover = cardCoverImage(race);
  const mainImage = cover || flyerImage(race) || coverImage(race);
  const blurSrc = cover || mainImage;
  const siteUrl = eventSiteUrl(race);
  const free = isEventFree(race);
  const { date, time } = formatDateTime(race.event_date);
  const phases = simplifiedPricingPhases(race);
  const finalized = isFinalized(race);
  const indexed = race.listing_type === "indexed";
  const externalPlatform = useMemo(() => {
    const named = String(race.source_name || "").trim();
    if (named) return named;
    try {
      return new URL(String(race.external_registration_url || "")).hostname.replace(/^www\./, "");
    } catch {
      return "sitio externo";
    }
  }, [race.source_name, race.external_registration_url]);
  const activePhase = useMemo(() => {
    const now = Date.now();
    return (race.pricing_phases || [])
      .filter((phase) => {
        const start = Date.parse(phase.starts_at || "");
        const end = Date.parse(phase.ends_at || "");
        return (!Number.isFinite(start) || start <= now) && (!Number.isFinite(end) || now <= end);
      })
      .filter((phase) => Number.isFinite(Number(phase.price)) && Number(phase.price) >= 0)
      .sort((a, b) => Number(a.price) - Number(b.price))[0] || null;
  }, [race.pricing_phases]);
  const activePrice = activePhase ? Number(activePhase.price) : phases[0]?.price;
  const activePriceLabel = activePrice != null
    ? new Intl.NumberFormat("es-MX", { style: "currency", currency: race.currency || "MXN", maximumFractionDigits: 0 }).format(activePrice)
    : null;
  const ctaLabel = indexed
    ? `Comprar en ${externalPlatform}`
    : finalized
    ? "Evento finalizado"
    : activePrice === 0 || (activePhase == null && free)
      ? "Inscríbete gratis"
      : activePriceLabel
        ? `Inscríbete por ${activePriceLabel}`
        : "Inscribirse";
  const registroUrl = !indexed && siteUrl
    ? `${siteUrl.replace(/\/$/, "")}/registro?embed=1&mp=1`
    : null;
  const orgImg = organizerImage(race);
  const orgSlug = organizerSlugFrom(race);
  const { isSaved, toggleSave } = useSavedRaces();
  const saved = isSaved(race.id);
  const [popSave, setPopSave] = useState(false);
  const [popShare, setPopShare] = useState(false);
  const [shareBusy, setShareBusy] = useState(false);
  const [shareCard, setShareCard] = useState<{ blob: Blob; url: string; filename: string } | null>(null);
  const [eventMetrics, setEventMetrics] = useState<EventMetricSnapshot>({ views: 0, saves: 0 });
  const [portalReady, setPortalReady] = useState(false);
  const [reviewData, setReviewData] = useState<EventReviewData>(EMPTY_EVENT_REVIEWS);
  const [reviewsLoading, setReviewsLoading] = useState(true);
  const eventStartsAt = useMemo(() => Date.parse(String(race.event_date || "")), [race.event_date]);
  const hasEventStart = Number.isFinite(eventStartsAt);
  const [eventClock, setEventClock] = useState<number | null>(null);
  const eventHasStarted = !hasEventStart || (eventClock !== null && eventClock >= eventStartsAt);
  const eventCountdown = useMemo(() => {
    if (!hasEventStart || eventHasStarted || eventClock === null) return null;
    const totalSeconds = Math.max(0, Math.ceil((eventStartsAt - eventClock) / 1000));
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    return `${days} ${days === 1 ? "día" : "días"} · ${String(hours).padStart(2, "0")} h · ${String(minutes).padStart(2, "0")} min · ${String(seconds).padStart(2, "0")} s`;
  }, [eventClock, eventHasStarted, eventStartsAt, hasEventStart]);

  const loadReviews = useCallback(async () => {
    setReviewsLoading(true);
    try {
      setReviewData(await fetchEventReviews(race.id));
    } catch {
      setReviewData(EMPTY_EVENT_REVIEWS);
    } finally {
      setReviewsLoading(false);
    }
  }, [race.id]);

  useEffect(() => {
    setPortalReady(true);
  }, []);

  useEffect(() => {
    void loadReviews();
  }, [loadReviews]);

  useEffect(() => {
    if (!hasEventStart) return;
    let timer: number | undefined;
    const tick = () => {
      const now = Date.now();
      setEventClock(now);
      if (now >= eventStartsAt && timer !== undefined) window.clearInterval(timer);
    };
    tick();
    if (Date.now() < eventStartsAt) timer = window.setInterval(tick, 1000);
    return () => {
      if (timer !== undefined) window.clearInterval(timer);
    };
  }, [eventStartsAt, hasEventStart]);

  useEffect(() => {
    return () => {
      if (shareCard?.url) URL.revokeObjectURL(shareCard.url);
    };
  }, [shareCard?.url]);

  async function onToggleSave() {
    setPopSave(true);
    window.setTimeout(() => setPopSave(false), 400);
    await toggleSave(race.id);
  }

  async function shareEvent() {
    if (shareBusy) return;
    setPopShare(true);
    window.setTimeout(() => setPopShare(false), 400);
    const url = marketplaceEventUrl(race);
    if (!url) return;
    setShareBusy(true);
    try {
      let metrics = eventMetrics;
      try {
        const response = await fetch(`${METRICS_API}/${encodeURIComponent(race.id)}`, { cache: "no-store" });
        if (response.ok) metrics = await response.json();
      } catch {
        // Use the last live metrics already displayed on the event card.
      }
      const remaining = hasEventStart ? Math.max(0, eventStartsAt - Date.now()) : 0;
      const days = Math.ceil(remaining / 86400000);
      const hours = Math.ceil(remaining / 3600000);
      const minutes = Math.max(1, Math.ceil(remaining / 60000));
      const status = finalized
        ? "Ven a dejar tu reseña"
        : remaining >= 86400000
          ? `Faltan ${days} ${days === 1 ? "día" : "días"}`
          : remaining >= 3600000
            ? `Faltan ${hours} ${hours === 1 ? "hora" : "horas"}`
            : remaining > 0
              ? `Faltan ${minutes} ${minutes === 1 ? "minuto" : "minutos"}`
              : "El evento ya comenzó";
      const blob = await createEventShareCard({
        title: race.name,
        organizer: organizerLabel(race),
        imageUrl: flyerImage(race) || mainImage,
        status,
        finalized,
        views: Number(metrics.views) || 0,
        saves: Number(metrics.saves) || 0,
        rating: Number(reviewData.average) || 0,
        reviewCount: Number(reviewData.count) || 0,
      });
      const filename = `${billboardSlug(race) || "evento-dorsalia"}-historia.png`;
      setShareCard({ blob, url: URL.createObjectURL(blob), filename });
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      await navigator.clipboard?.writeText(url).catch(() => undefined);
    } finally {
      setShareBusy(false);
    }
  }

  function downloadShareCard() {
    if (!shareCard) return;
    const link = document.createElement("a");
    link.href = shareCard.url;
    link.download = shareCard.filename;
    link.click();
  }

  async function shareRenderedCard() {
    if (!shareCard) return;
    const url = marketplaceEventUrl(race) || window.location.href;
    const file = new File([shareCard.blob], shareCard.filename, { type: "image/png" });
    try {
      if (navigator.share && (!navigator.canShare || navigator.canShare({ files: [file] }))) {
        await navigator.share({ title: race.name, text: `${race.name} en Dorsalia`, url, files: [file] });
        return;
      }
      downloadShareCard();
      await navigator.clipboard?.writeText(url).catch(() => undefined);
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      downloadShareCard();
    }
  }

  const routes = useMemo(() => {
    const list = Array.isArray(race.routes) ? race.routes : [];
    return list;
  }, [race.routes]);

  const gallery = useMemo(
    () => (Array.isArray(race.gallery_urls) ? race.gallery_urls : []).map((url, index) => ({ id: `event-${index}`, url: String(url || "").trim(), alt: `${race.name} — foto ${index + 1}` })).filter((item) => item.url),
    [race.gallery_urls, race.name],
  );

  const money = useMemo(
    () => new Intl.NumberFormat("es-MX", { style: "currency", currency: race.currency || "MXN", maximumFractionDigits: 0 }),
    [race.currency],
  );

  function routePriceLabel(route: PublicEventRoute) {
    const direct = route.price == null ? null : Number(route.price);
    const price = direct != null && Number.isFinite(direct) ? direct : activePrice;
    if (price == null || !Number.isFinite(price)) return "Precio por confirmar";
    return price === 0 ? "Gratis" : money.format(price);
  }

  const medals = useMemo(() => {
    const seen = new Set<string>();
    const out: { url: string; alt: string; key: string }[] = [];
    for (const r of routes) {
      const url = String(r.medal_image_url || "").trim();
      if (!url || seen.has(url)) continue;
      seen.add(url);
      out.push({
        url,
        key: r.key || url,
        alt: String(r.medal_label || r.label || "Medalla").trim() || "Medalla",
      });
    }
    return out;
  }, [routes]);

  const aboutText = String(race.description || "").trim() || seoDescription(race);
  const aboutLong = aboutText.length > 160;

  const routesWithMap = useMemo(
    () => routes.filter((r) => routeTrace(r.map).hasTrace),
    [routes],
  );

  const [activeRouteKey, setActiveRouteKey] = useState(() => routesWithMap[0]?.key || routes[0]?.key || "");

  function requestClose() {
    if (closingRef.current) return;
    if (standalone) {
      if (window.history.length > 1) window.history.back();
      else window.location.assign("/");
      return;
    }
    closingRef.current = true;
    setState("closing");
    window.setTimeout(() => onClose?.(), CLOSE_MS);
  }

  useEffect(() => {
    setShowForm(false);
    setMainImageLoaded(false);
    setRegistroImmersive(false);
    setAboutExpanded(false);
    setActiveRouteKey(routesWithMap[0]?.key || routes[0]?.key || "");
  }, [race.id, routes, routesWithMap]);

  useEffect(() => {
    const frame = window.requestAnimationFrame(() => {
      if (mainImageRef.current?.complete && mainImageRef.current.naturalWidth > 0) setMainImageLoaded(true);
    });
    return () => window.cancelAnimationFrame(frame);
  }, [mainImage]);

  useEffect(() => {
    if (!showForm) {
      setRegistroImmersive(false);
      return;
    }
    const onMessage = (event: MessageEvent) => {
      const data = event.data;
      if (!data || typeof data !== "object") return;
      if (data.type === "dorsalia:registro-immersive") {
        setRegistroImmersive(Boolean(data.immersive));
      }
      if (data.type === "dorsalia:registro-close") {
        setShowForm(false);
        setRegistroImmersive(false);
      }
    };
    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [showForm]);

  useEffect(() => {
    const prevOverflow = document.body.style.overflow;
    const prevOverflowX = document.body.style.overflowX;
    document.body.style.overflow = "hidden";
    document.body.style.overflowX = "hidden";
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== "Escape") return;
      if (showForm) {
        setShowForm(false);
        return;
      }
      requestClose();
    };
    window.addEventListener("keydown", onKey);
    return () => {
      document.body.style.overflow = prevOverflow;
      document.body.style.overflowX = prevOverflowX;
      window.removeEventListener("keydown", onKey);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [showForm]);

  const socialItems = useMemo(() => {
    const out: { key: string; url: string; icon: string; label: string }[] = [];
    const links = race.social_links || {};
    const order = ["instagram", "facebook", "tiktok", "whatsapp", "youtube", "x"] as const;
    for (const key of order) {
      const icon = SOCIAL_ICONS[key];
      if (!icon) continue;
      const item = (links as Record<string, { url?: string } | undefined>)[key];
      const url = String(item?.url || "").trim();
      if (!url) continue;
      out.push({ key, url, icon, label: key });
    }
    // Legacy Instagram fields if not in social_links
    if (!out.some((s) => s.key === "instagram")) {
      const handle = String(race.instagram_handle || "").replace(/^@/, "").trim();
      const url = race.instagram_url || (handle ? `https://instagram.com/${handle}` : null);
      if (url) {
        out.unshift({
          key: "instagram",
          url,
          icon: SOCIAL_ICONS.instagram,
          label: "instagram",
        });
      }
    }
    return out;
  }, [race]);

  const activeRoute: PublicEventRoute | null =
    routesWithMap.find((r) => r.key === activeRouteKey) || routesWithMap[0] || null;
  // Keep route arrays referentially stable when reviews or form fields update.
  // Recreating them tears down MapLibre and makes the route appear to replay.
  const activeTrace = useMemo(
    () => (activeRoute ? routeTrace(activeRoute.map) : null),
    [activeRoute],
  );

  const phaseBar = !indexed ? (
    <div className="absolute inset-x-0 bottom-0 z-10 flex justify-center pb-[30px] px-3">
      <span className="absolute bottom-[34px] left-3 rounded-full border border-[#c9f24b]/70 bg-[#c9f24b] px-3 py-2 text-[10px] font-extrabold uppercase tracking-[0.08em] text-black sm:left-5">
        Evento Dorsalia
      </span>
      <GlassPanel
        radius={999}
        variant="dark"
        style={{ width: "fit-content", maxWidth: "100%" }}
        glassProps={{
          glassColor: "rgba(10,10,10,0.42)",
          borderColor: "rgba(255,255,255,0.28)",
          blur: 22,
          saturation: 140,
          aberrationIntensity: 0.06,
        }}
      >
        <div
          className="flex items-center justify-center"
          style={{
            paddingLeft: 23,
            paddingRight: 23,
            paddingTop: 10,
            paddingBottom: 10,
            gap: 40,
          }}
        >
          {phases.map((phase) => {
            const freeOnly = phase.price <= 0 && phases.length === 1;
            return (
              <div
                key={`${phase.label}-${phase.priceLabel}`}
                className="shrink-0 text-center whitespace-nowrap"
              >
                {freeOnly ? (
                  <p className="text-[15px] font-bold leading-none text-white">Gratis</p>
                ) : (
                  <>
                    <p className="text-[11px] font-medium leading-none text-white/70">
                      {phase.label}
                    </p>
                    <p className="mt-1.5 text-[15px] font-bold leading-none text-white">
                      {phase.priceLabel}
                    </p>
                  </>
                )}
              </div>
            );
          })}
        </div>
      </GlassPanel>
    </div>
  ) : null;

  const orgPresented = (
    <>
      {orgImg ? (
        // eslint-disable-next-line @next/next/no-img-element
        <img
          src={orgImg}
          alt=""
          className="h-7 w-7 shrink-0 rounded-full object-cover"
        />
      ) : (
        <span className="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/15 text-[11px] font-semibold text-white">
          {organizerLabel(race).slice(0, 1).toUpperCase()}
        </span>
      )}
      <span>
        <span className="text-white/50">Presentado por </span>
        <span className="font-semibold text-white">{organizerLabel(race)}</span>
      </span>
    </>
  );

  if (!standalone && !portalReady) return null;

  const preview = (
    <div
      className="mp-preview-root fixed inset-0 z-[200] overflow-y-auto overflow-x-hidden overscroll-contain"
      data-state={state}
      role="dialog"
      aria-modal="true"
      aria-labelledby="event-preview-title"
    >
      <div className="mp-preview-backdrop pointer-events-none fixed inset-0 bg-black" aria-hidden>
        {blurSrc ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img
            src={blurSrc}
            alt=""
            className="absolute inset-0 h-full w-full scale-[1.45] object-cover opacity-75 blur-[100px] saturate-150"
            style={{ filter: "blur(100px) saturate(1.5)", WebkitFilter: "blur(100px) saturate(1.5)" }}
          />
        ) : null}
        <div className="absolute inset-0 bg-black/65" />
      </div>

      <div className="mp-preview-sheet relative z-10 min-h-full w-full min-w-0 max-w-full overflow-x-hidden">
        {shareCard ? (
          <div className="fixed inset-0 z-[280] grid place-items-center overflow-y-auto bg-black/85 p-4 backdrop-blur-xl" role="dialog" aria-modal="true" aria-label="Vista previa para compartir">
            <div className="w-full max-w-sm rounded-[28px] border border-white/15 bg-[#111] p-4 shadow-2xl">
              <div className="flex items-center justify-between gap-4 px-1 pb-3">
                <div>
                  <p className="text-sm font-bold text-white">Historia para compartir</p>
                  <p className="text-[11px] text-white/45">1080 × 1920 PNG</p>
                </div>
                <button type="button" onClick={() => setShareCard(null)} className="grid h-10 w-10 place-items-center rounded-full bg-white/10 text-2xl leading-none text-white" aria-label="Cerrar vista previa">×</button>
              </div>
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img src={shareCard.url} alt={`Historia de ${race.name} lista para compartir`} className="mx-auto max-h-[65vh] w-auto max-w-full rounded-[18px] bg-black object-contain" />
              <div className="mt-4 grid grid-cols-2 gap-2">
                <button type="button" onClick={() => void shareRenderedCard()} className="rounded-full bg-[#c9f24b] px-4 py-3 text-sm font-extrabold text-black">Compartir imagen</button>
                <button type="button" onClick={downloadShareCard} className="rounded-full border border-white/20 bg-white/10 px-4 py-3 text-sm font-bold text-white">Descargar PNG</button>
              </div>
            </div>
          </div>
        ) : null}
        <div
          className="mp-preview-chrome fixed inset-x-0 top-0 z-30 flex items-center justify-between pointer-events-none"
          style={{ paddingTop: 15, paddingLeft: 20, paddingRight: 20, paddingBottom: 8 }}
        >
          <div className="pointer-events-auto">
            <GlassIconButton aria-label="Cerrar" onClick={requestClose}>
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img src={ICON_BACK} alt="" width={24} height={24} />
            </GlassIconButton>
          </div>

          <div className="pointer-events-auto ml-auto flex items-center" style={{ gap: 10 }}>
            <div className={popSave ? "mp-icon-pop" : undefined}>
              <GlassIconButton
                aria-label={saved ? `Quitar ${race.name} de guardados` : `Guardar ${race.name}`}
                onClick={() => void onToggleSave()}
              >
                <svg width="24" height="24" viewBox="0 0 40 40" fill="none" aria-hidden>
                  <path
                    d="M20 14.6176C17.5 8.7496 8.75 9.3746 8.75 16.8746C8.75 24.3747 20 30.6249 20 30.6249C20 30.6249 31.25 24.3747 31.25 16.8746C31.25 9.3746 22.5 8.7496 20 14.6176Z"
                    stroke="white"
                    strokeWidth="1.5"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    fill={saved ? "white" : "none"}
                  />
                </svg>
              </GlassIconButton>
            </div>
            <div className={popShare ? "mp-icon-pop" : undefined}>
              <GlassIconButton aria-label={shareBusy ? "Creando imagen para compartir" : "Compartir"} onClick={() => void shareEvent()}>
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img
                  ref={mainImageRef}
                  src={ICON_SHARE}
                  alt=""
                  width={24}
                  height={24}
                  style={{ filter: "brightness(0) invert(1)" }}
                />
              </GlassIconButton>
            </div>
          </div>
        </div>

        <div
          className="mp-preview-panel relative z-10 mx-auto box-border w-full min-w-0 max-w-lg overflow-x-hidden px-5 pb-28 md:max-w-5xl md:px-8 md:pb-24"
          // Top controls: 15px offset + 44px button. The panel begins exactly
          // 20px below their lower edge so the cover never sits underneath them.
          style={{ paddingTop: 79 }}
        >
        <div className="grid min-w-0 max-w-full items-start gap-8 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-12">
          <div className="min-w-0 max-w-full space-y-4">
            {mainImage ? (
              <div className={`relative overflow-hidden rounded-[28px] bg-[#141414] shadow-[0_30px_80px_rgba(0,0,0,0.45)] ${indexed ? "min-h-[260px] w-full" : "aspect-[3/4]"}`}>
                {!mainImageLoaded ? <div className="absolute inset-0 z-[2] grid place-items-center" role="status" aria-label="Cargando portada"><span className="h-10 w-10 animate-spin rounded-full border-2 border-white/20 border-t-[#c9f24b]" /></div> : null}
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img
                  src={mainImage}
                  alt={`Portada de ${race.name}`}
                  onLoad={() => setMainImageLoaded(true)}
                  className={`${indexed ? "relative block h-auto w-full object-contain" : "absolute inset-0 h-full w-full object-cover"} transition-opacity duration-300 ${mainImageLoaded ? "opacity-100" : "opacity-0"}`}
                />
                {indexed && (race.source_credit || race.source_name) ? (
                  <a
                    href={race.source_url || undefined}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    className="absolute bottom-3 left-3 z-20 max-w-[calc(100%-24px)] rounded-full bg-black/60 px-3 py-1.5 text-[10px] text-white/80 backdrop-blur-md"
                  >
                    {race.source_credit || `Fuente: ${race.source_name}`}
                  </a>
                ) : null}
                {phaseBar}
              </div>
            ) : (
              <div className="relative aspect-[3/4] rounded-[28px] bg-white/5 grid place-items-center font-akira text-white/40">
                {race.name}
                {phaseBar}
              </div>
            )}
          </div>

          <div className="min-w-0 max-w-full md:pt-4">
            <div className="min-w-0 max-w-full">
              <h1
                id="event-preview-title"
                className="max-w-full break-words font-akira text-[clamp(1.75rem,8vw,2rem)] leading-[1.08] tracking-wide text-white [overflow-wrap:anywhere]"
              >
                {race.name}
              </h1>

              {orgSlug ? (
                <Link
                  href={`/org/${orgSlug}`}
                  className="mt-3 inline-flex items-center gap-2.5 text-sm text-white hover:opacity-90 transition-opacity"
                >
                  {orgPresented}
                </Link>
              ) : (
                <p className="mt-3 inline-flex items-center gap-2.5 text-sm text-white">
                  {orgPresented}
                </p>
              )}
              <EventRatingSummary
                data={reviewData}
                locked={!eventHasStarted}
                countdown={eventCountdown}
              />
              <EventMetrics raceEventId={race.id} onChange={setEventMetrics} />
            </div>

            <div
              className="text-white/90"
              style={{ marginTop: 30, display: "flex", flexDirection: "column", gap: 5 }}
            >
              <p className="flex items-center gap-3 text-[18px] leading-snug">
                <span aria-hidden className="shrink-0 text-white">
                  <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M3 10h18M8 3v4M16 3v4" />
                  </svg>
                </span>
                <span>
                  <span className="block">{date}</span>
                  {time ? <span className="block text-white/70">{time}</span> : null}
                </span>
              </p>
              <p className="flex items-center gap-3 text-[18px] leading-snug">
                <span aria-hidden className="shrink-0 text-white">
                  <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                    <path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z" />
                    <circle cx="12" cy="10" r="2.2" />
                  </svg>
                </span>
                <span>{placeLabel(race)}</span>
              </p>
            </div>

            <div className="flex w-full min-w-0 max-w-md flex-col gap-3" style={{ marginTop: 30 }}>
              {indexed && race.external_registration_url ? (
                <>
                  <a
                    href={race.external_registration_url}
                    target="_blank"
                    rel="noopener noreferrer nofollow sponsored"
                    className="flex min-h-[58px] w-full min-w-0 items-center justify-center rounded-full border border-white bg-white px-5 py-[13px] text-center text-[clamp(1rem,5vw,1.25rem)] font-bold uppercase leading-tight tracking-wide !text-black transition hover:brightness-95"
                    style={{ color: "#000000" }}
                  >
                    {ctaLabel}
                  </a>
                  <p className="max-w-full break-words px-2 text-center text-[12px] leading-relaxed text-white/55 [overflow-wrap:anywhere] sm:px-4">
                    Los boletos no son procesados por Dorsalia. La compra la gestiona {externalPlatform} y está sujeta a sus políticas, términos y condiciones.
                  </p>
                </>
              ) : registroUrl || finalized ? (
                <Button
                  variant="primary"
                  type="button"
                  fullWidth
                  onClick={() => { if (!finalized) setShowForm(true); }}
                  disabled={finalized}
                  className="!border-[#c9f24b] !bg-[#c9f24b] !text-black hover:!brightness-95 !text-[20px] !py-[15px] uppercase tracking-wide"
                >
                  {ctaLabel}
                </Button>
              ) : null}
              {siteUrl && !indexed ? (
                <GlassPanel
                  radius={20}
                  variant="dark"
                  className="w-full"
                  glassProps={{
                    glassColor: "rgba(12,12,12,0.35)",
                    borderColor: "rgba(255,255,255,0.45)",
                    blur: 18,
                  }}
                >
                  <a
                    href={siteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex w-full items-center justify-center px-6 py-[15px] text-[20px] font-bold uppercase tracking-wide text-white"
                  >
                    Visitar sitio
                  </a>
                </GlassPanel>
              ) : null}
            </div>
          </div>
        </div>

        <div className="mt-10 grid min-w-0 max-w-full items-start gap-8 md:mt-14 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-12">
          <div className="min-w-0 max-w-full">
            <section className="w-full min-w-0 max-w-xl overflow-hidden">
              <h3 className="text-[22px] font-semibold leading-tight text-white">
                Sobre el evento
              </h3>
              <div className="relative min-w-0 max-w-full overflow-hidden" style={{ marginTop: 10 }}>
                <div
                  style={
                    !aboutExpanded && aboutLong
                      ? {
                          WebkitMaskImage:
                            "linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%)",
                          maskImage:
                            "linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%)",
                        }
                      : undefined
                  }
                >
                  <RichEventText value={aboutText} collapsed={!aboutExpanded && aboutLong} />
                </div>
                {aboutLong ? (
                  <button
                    type="button"
                    onClick={() => setAboutExpanded((v) => !v)}
                    className="mt-2 text-[18px] font-medium text-white"
                  >
                    {aboutExpanded ? "Mostrar menos" : "Mostrar más"}
                  </button>
                ) : null}
              </div>
              {race.convocatoria_url ? (
                <a href={race.convocatoria_url} target="_blank" rel="noopener noreferrer" className="mt-5 inline-flex items-center justify-center rounded-full border border-white/25 bg-white/10 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white/15">
                  Ver convocatoria
                </a>
              ) : null}
            </section>

            {medals.length > 0 ? (
              <section className="mt-10 w-full min-w-0 max-w-xl overflow-hidden">
                <h3 className="text-[22px] font-semibold leading-tight text-white">
                  Modalidades
                </h3>
                <div className="mt-4 flex flex-wrap items-end gap-4">
                  {medals.map((m) => (
                    // eslint-disable-next-line @next/next/no-img-element
                    <img
                      key={m.key}
                      src={m.url}
                      alt={m.alt}
                      className="h-[88px] w-auto object-contain"
                    />
                  ))}
                </div>
              </section>
            ) : null}
          </div>

          {(routesWithMap.length > 0 || routes.length > 0) ? (
            <section className="w-full min-w-0 max-w-full overflow-hidden">
              {routes.length > 0 ? (
                <div className="mb-8">
                  <h3 className="text-[22px] font-semibold leading-tight text-white">Modalidades</h3>
                  <div className="mt-4 grid gap-3">
                    {routes.map((route) => (
                      <article key={route.key} className="box-border w-full min-w-0 max-w-full overflow-hidden rounded-[20px] border border-white/15 bg-white/[0.06] px-4 py-4">
                        <div className="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-start gap-3">
                          <h4 className="min-w-0 break-words text-[17px] font-semibold text-white [overflow-wrap:anywhere]">{route.label}</h4>
                          <span className="shrink-0 rounded-full bg-[#c9f24b] px-3 py-1 text-[12px] font-bold text-black">{routePriceLabel(route)}</span>
                        </div>
                        {route.description ? <p className="mt-2 max-w-full whitespace-pre-wrap break-words text-[14px] leading-relaxed text-white/70 [overflow-wrap:anywhere]">{route.description}</p> : null}
                      </article>
                    ))}
                  </div>
                </div>
              ) : null}
              <h3 className="text-[22px] font-semibold leading-tight text-white">Ruta</h3>

              {activeTrace?.hasTrace ? (
                <div className="relative mt-5 aspect-[4/5] w-full min-w-0 max-w-full overflow-hidden rounded-[28px] bg-black">
                  {routesWithMap.length > 1 ? (
                    <div
                      className="pointer-events-none absolute z-[600] flex max-w-[calc(100%-30px)] flex-wrap gap-1.5"
                      style={{ top: 15, left: 15 }}
                    >
                      {routesWithMap.map((route) => {
                        const active = route.key === (activeRoute?.key || routesWithMap[0]?.key);
                        return (
                          <button
                            key={route.key}
                            type="button"
                            onClick={() => setActiveRouteKey(route.key)}
                            className={`mp-card-badge pointer-events-auto whitespace-nowrap px-[10px] py-[5px] text-[10px] font-bold uppercase tracking-[0.08em] text-white transition-opacity ${
                              active ? "opacity-100" : "opacity-70"
                            }`}
                          >
                            {route.label}
                          </button>
                        );
                      })}
                    </div>
                  ) : null}
                  <AnimatedRouteMap
                    key={activeRoute?.key || "route"}
                    polyline={activeTrace.polyline}
                    waypoints={activeTrace.waypoints}
                    points={activeTrace.points}
                    routeName={activeRoute?.label || "Ruta"}
                    distanceLabel={formatDistance(Number(activeRoute?.distance_m) || activeTrace.distance_m)}
                    eventName={race.name}
                    organizerLogoUrl={race.logo_url}
                    raceEventId={race.id}
                    routeKey={activeRoute?.key || routesWithMap[0]?.key || "route"}
                  />
                </div>
              ) : (
                <p className="mt-4 text-sm text-white/55">
                  {routes.map((r) => r.label).filter(Boolean).join(" · ") || "Rutas por publicar"}
                </p>
              )}
            </section>
          ) : null}
        </div>

        {gallery.length > 0 ? (
          <section className="mt-12">
            <h3 className="mb-5 text-center font-akira text-[22px] font-semibold uppercase leading-tight text-white">Galería del evento</h3>
            <div className="-mx-5 md:-mx-8"><PublicGalleryCarousel items={gallery} /></div>
          </section>
        ) : null}

        {(race.contact_email || race.organizer_phone || race.organizer_whatsapp) ? (
          <section className="mt-10 max-w-3xl rounded-[24px] border border-white/10 bg-white/[0.05] p-5">
            <h3 className="text-[20px] font-semibold text-white">Contacto del organizador</h3>
            <div className="mt-4 flex flex-wrap gap-3">
              {race.contact_email ? <a href={`mailto:${race.contact_email}`} className="inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/15 px-4 py-2.5 text-sm font-medium text-white transition hover:border-white/40 hover:bg-white/[0.07]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span>{race.contact_email}</span></a> : null}
              {race.organizer_phone ? <a href={`tel:${race.organizer_phone}`} className="inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/15 px-4 py-2.5 text-sm font-medium text-white transition hover:border-white/40 hover:bg-white/[0.07]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z"/></svg><span>{race.organizer_phone}</span></a> : null}
              {race.organizer_whatsapp ? <a href={`https://wa.me/${race.organizer_whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-black/15 px-4 py-2.5 text-sm font-medium text-white transition hover:border-white/40 hover:bg-white/[0.07]"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden><path d="M12.04 2a9.84 9.84 0 0 0-8.43 14.91L2 22l5.22-1.56A9.98 9.98 0 1 0 12.04 2Zm0 17.96a8 8 0 0 1-4.08-1.12l-.29-.17-3.1.93.96-3.02-.19-.31A7.94 7.94 0 1 1 12.04 19.96Zm4.36-5.95c-.24-.12-1.41-.69-1.63-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.19-.71-.63-1.19-1.42-1.33-1.66-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.47-.39-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.41-.58 1.61-1.13.2-.56.2-1.03.14-1.13-.06-.1-.22-.16-.46-.28Z"/></svg><span>{race.organizer_whatsapp}</span></a> : null}
            </div>
          </section>
        ) : null}

        <EventCommunityQuestions raceEventId={race.id} returnSlug={billboardSlug(race)} />

        {eventHasStarted ? (
          <EventReviews
            raceEventId={race.id}
            returnSlug={billboardSlug(race)}
            data={reviewData}
            loading={reviewsLoading}
            onReload={loadReviews}
          />
        ) : null}

        <p className="mt-10 max-w-3xl text-[11px] leading-relaxed text-white/45 md:mt-12">
          {indexed ? (
            <>
              <strong className="text-white/65">Compra de boletos externa.</strong>{" "}
              Esta ficha reúne información pública del evento. La compra, el pago,
              los términos, cambios, reembolsos y entrega de kits son responsabilidad
              de {organizerLabel(race)} y de {externalPlatform}. Dorsalia no procesa
              esta transacción. Verifica la información en el sitio enlazado antes de comprar.{" "}
            </>
          ) : (
            <>
              El precio puede variar y ser modificado por el organizador (fases,
              cupos u otras reglas del evento). Si ya pagaste una inscripción a
              un precio menor y el precio sube después, no debes pagar nada
              extra por esa misma inscripción. Los términos, reglamentos,
              reembolsos, kit y condiciones del evento son responsabilidad del
              organizador; Dorsalia opera la plataforma tecnológica y no es el
              organizador del evento.{" "}
            </>
          )}
          <Link
            href="/terminos"
            className="text-white/65 underline underline-offset-2 hover:text-white/90"
          >
            Ver términos
          </Link>
          .
        </p>

        {socialItems.length > 0 ? (
          <div className="mt-8 flex flex-wrap items-center gap-4">
            {socialItems.map((s) => (
              <a
                key={`${s.key}-${s.url}`}
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                className="grid h-10 w-10 place-items-center opacity-90 transition-opacity hover:opacity-100"
              >
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img src={s.icon} alt="" width={24} height={24} className="h-6 w-6" />
              </a>
            ))}
          </div>
        ) : null}

        <a
          href={`mailto:contacto@dorsalia.run?subject=${encodeURIComponent(
            `Reporte de evento: ${race.name}`,
          )}`}
          className="mt-14 mb-4 inline-flex max-w-xl items-center gap-2.5 text-[14px] text-white/55 hover:text-white/80 transition-colors"
        >
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={ICON_HELP}
            alt=""
            width={20}
            height={20}
            className="h-5 w-5 shrink-0 opacity-70"
            style={{ filter: "brightness(0) invert(1)" }}
          />
          <span>Presentas algún problema o deseas reportar este evento?</span>
        </a>
        {indexed && race.organizer_is_provisional && race.workspace_id ? (
          <a
            href={`https://portal.dorsalia.run/reclamar-organizador?workspaceId=${encodeURIComponent(race.workspace_id)}`}
            className="mb-8 block max-w-3xl rounded-2xl border border-white/10 bg-white/[0.04] px-5 py-4 text-sm text-white/65 transition hover:border-white/25 hover:bg-white/[0.07] hover:text-white"
          >
            ¿Este es tu evento? <span className="font-semibold text-white">Reclama el perfil con una verificación</span>
          </a>
        ) : null}
        </div>
        {standalone ? <SiteFooter /> : null}
      </div>

      {showForm && registroUrl ? (
        <div
          className={`fixed inset-0 z-[210] flex overflow-x-hidden overscroll-none ${
            registroImmersive
              ? "items-stretch justify-stretch p-0"
              : "items-end sm:items-center justify-center p-0 sm:p-6"
          }`}
          role="dialog"
          aria-modal="true"
          aria-label={`Inscripción a ${race.name}`}
        >
          {!registroImmersive ? (
            <button
              type="button"
              className="absolute inset-0 bg-black/75 backdrop-blur-sm"
              aria-label="Cerrar inscripción"
              onClick={() => setShowForm(false)}
            />
          ) : (
            <div className="absolute inset-0 bg-black" aria-hidden />
          )}
          <div
            className={`mp-registro-shell relative z-10 box-border flex w-full flex-col overflow-hidden overflow-x-hidden bg-black ${
              registroImmersive
                ? "h-[100dvh] max-w-none rounded-none border-0"
                : "h-[min(92dvh,880px)] max-w-lg rounded-t-[24px] sm:rounded-[24px] border border-white/10 shadow-[0_40px_100px_rgba(0,0,0,0.65)] mp-rise-in"
            }`}
          >
            {!registroImmersive ? (
              <div className="flex w-full max-w-full shrink-0 items-center justify-between gap-3 border-b border-white/10 px-4 py-3">
                <div className="min-w-0 flex-1 overflow-hidden">
                  <p className="truncate text-sm font-semibold text-white">Inscripción</p>
                  <p className="truncate text-[11px] text-white/45">{race.name}</p>
                </div>
                <button
                  type="button"
                  onClick={() => setShowForm(false)}
                  className="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
                  aria-label="Cerrar"
                >
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden>
                    <path
                      d="M1 1l12 12M13 1L1 13"
                      stroke="currentColor"
                      strokeWidth="1.75"
                      strokeLinecap="round"
                    />
                  </svg>
                </button>
              </div>
            ) : null}
            <iframe
              title={`Inscripción a ${race.name}`}
              src={registroUrl}
              className="block h-full min-h-0 w-full max-w-full flex-1 border-0 bg-black"
              style={{ width: "100%", maxWidth: "100%" }}
              allow="payment *"
            />
          </div>
        </div>
      ) : null}
    </div>
  );

  return standalone ? preview : createPortal(preview, document.body);
}

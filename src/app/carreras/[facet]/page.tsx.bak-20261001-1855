import type { Metadata } from "next";
import Link from "next/link";
import { notFound } from "next/navigation";
import {
  SPORT_CATEGORY_LABELS, cardCoverImage, facetSlug, fetchPublicRaces,
  formatDate, formatMinPrice, marketplaceEventUrl, raceMatchesFacet,
  sortByClosestDate, sportCategoryLabel,
} from "@/lib/races";

export const revalidate = 60;
type Props = { params: Promise<{ facet: string }> };

async function facetData(raw: string) {
  const facet = facetSlug(raw);
  const all = (await fetchPublicRaces({ status: "all" })).filter((race) => race.is_published && race.robots_index !== false);
  const races = sortByClosestDate(all.filter((race) => raceMatchesFacet(race, facet)));
  const isSport = Boolean(SPORT_CATEGORY_LABELS[facet]);
  const locationRace = races.find((race) => facetSlug(race.state) === facet || facetSlug(race.city) === facet);
  const label = isSport ? SPORT_CATEGORY_LABELS[facet] : (locationRace?.state && facetSlug(locationRace.state) === facet ? locationRace.state : locationRace?.city) || facet.replace(/-/g, " ").replace(/(^|\s)\S/g, (letter) => letter.toUpperCase());
  return { facet, races, isSport, label };
}

export async function generateMetadata({ params }: Props): Promise<Metadata> {
  const { facet: raw } = await params;
  const { facet, races, isSport, label } = await facetData(raw);
  const title = isSport ? `${label}: carreras y eventos en México` : `Carreras en ${label}`;
  const description = isSport ? `Próximos eventos de ${label.toLowerCase()} en México: fechas, ubicaciones, modalidades, precios e inscripciones.` : `Próximas carreras y eventos deportivos en ${label}: fechas, rutas, precios e inscripciones.`;
  return { title, description, alternates: { canonical: `https://dorsalia.run/carreras/${facet}` }, robots: races.length ? { index: true, follow: true } : { index: false, follow: true } };
}

export default async function RaceFacetPage({ params }: Props) {
  const { facet: raw } = await params;
  const { facet, races, isSport, label } = await facetData(raw);
  if (!races.length) notFound();
  const title = isSport ? `${label} en México` : `Carreras en ${label}`;
  const schema = {
    "@context": "https://schema.org", "@type": "CollectionPage", name: title,
    url: `https://dorsalia.run/carreras/${facet}`,
    breadcrumb: { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Dorsalia", item: "https://dorsalia.run/" },
      { "@type": "ListItem", position: 2, name: "Carreras", item: "https://dorsalia.run/carreras" },
      { "@type": "ListItem", position: 3, name: label, item: `https://dorsalia.run/carreras/${facet}` },
    ] },
    mainEntity: { "@type": "ItemList", numberOfItems: races.length, itemListElement: races.map((race, index) => ({ "@type": "ListItem", position: index + 1, name: race.name, url: marketplaceEventUrl(race) })) },
  };
  return <main className="min-h-screen bg-[#070707] px-4 py-12 text-white sm:px-8">
    <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(schema) }} />
    <div className="mx-auto max-w-7xl"><nav className="text-sm text-white/50"><Link href="/">Dorsalia</Link> / <Link href="/carreras">Carreras</Link> / <span className="text-white/80">{label}</span></nav>
      <h1 className="mt-8 text-4xl font-black sm:text-6xl">{title}</h1>
      <p className="mt-4 max-w-3xl text-lg leading-8 text-white/60">{isSport ? `Consulta eventos de ${label.toLowerCase()}, compara modalidades y encuentra tu próxima meta.` : `Fechas, modalidades, rutas, precios e inscripciones de eventos deportivos en ${label}.`}</p>
      <p className="mt-3 text-sm font-bold text-[#c5ff32]">{races.length} evento{races.length === 1 ? "" : "s"}</p>
      <div className="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{races.map((race) => <Link key={race.id} href={marketplaceEventUrl(race)} className="overflow-hidden rounded-[26px] border border-white/10 bg-[#111] transition hover:-translate-y-1 hover:border-[#c5ff32]/60">
        <div className="aspect-[4/3] bg-white/5">{cardCoverImage(race) ? <img src={cardCoverImage(race)!} alt={`Portada de ${race.name}`} className="h-full w-full object-cover" /> : null}</div>
        <div className="p-5"><p className="text-xs font-bold uppercase tracking-wide text-[#c5ff32]">{sportCategoryLabel(race)} · {race.state || race.city || "México"}</p><h2 className="mt-3 text-xl font-bold leading-snug">{race.name}</h2><p className="mt-3 text-sm text-white/55">{formatDate(race.event_date)} · {formatMinPrice(race)}</p></div>
      </Link>)}</div>
    </div>
  </main>;
}

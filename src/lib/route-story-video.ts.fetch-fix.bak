import type { RoutePoint, RouteWaypoint } from "@/lib/routeMap";
import { resolveOpenFreeMapStyle } from "@/lib/openfree-map-style";

export const ROUTE_STORY_DURATION_MS = 20600;
const PLAY_MS = 20000, OVERVIEW_MS = 600, WIDTH = 1080, HEIGHT = 1920, FPS = 30;
const FOLLOW_ZOOM = 16, CAM_FOLLOW = 0.16, ROUTE_COLOR = "#cbff00";

export type RouteStoryOptions = { line: RouteWaypoint[]; points?: RoutePoint[]; routeName: string; distanceLabel?: string; eventName: string; organizerLogoUrl?: string | null; onProgress?: (progress: number) => void };
type Segment = { from: RouteWaypoint; to: RouteWaypoint; len: number; acc: number };

function fileSlug(value: string) { return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "ruta"; }
function loadImage(src?: string | null): Promise<HTMLImageElement | null> { if (!src) return Promise.resolve(null); return new Promise((resolve) => { const image = new Image(); image.crossOrigin = "anonymous"; image.onload = () => resolve(image); image.onerror = () => resolve(null); image.src = src; }); }
function fitImage(ctx: CanvasRenderingContext2D, image: HTMLImageElement, x: number, y: number, w: number, h: number) { const scale = Math.min(w / image.naturalWidth, h / image.naturalHeight); const dw = image.naturalWidth * scale, dh = image.naturalHeight * scale; ctx.drawImage(image, x + (w - dw) / 2, y + (h - dh) / 2, dw, dh); }
function haversine(a: RouteWaypoint, b: RouteWaypoint) { const rad = (v: number) => v * Math.PI / 180; const dLat = rad(b.lat - a.lat), dLng = rad(b.lng - a.lng); const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2; return 12742000 * Math.asin(Math.min(1, Math.sqrt(h))); }
function buildSegments(line: RouteWaypoint[]) { const segments: Segment[] = []; let total = 0; for (let i = 0; i < line.length - 1; i += 1) { const len = Math.max(.01, haversine(line[i], line[i + 1])); segments.push({ from: line[i], to: line[i + 1], len, acc: total }); total += len; } return { segments, total }; }
function pointAt(segments: Segment[], total: number, progress: number) { const distance = Math.min(1, Math.max(0, progress)) * total; const segment = segments.find((item) => distance <= item.acc + item.len) || segments[segments.length - 1]; const local = Math.min(1, Math.max(0, (distance - segment.acc) / segment.len)); return { lat: segment.from.lat + (segment.to.lat - segment.from.lat) * local, lng: segment.from.lng + (segment.to.lng - segment.from.lng) * local }; }
function prefix(line: RouteWaypoint[], segments: Segment[], total: number, progress: number) { if (progress >= 1) return line; const distance = progress * total, result = [line[0]]; for (const segment of segments) { if (distance >= segment.acc + segment.len) result.push(segment.to); else { const local = Math.max(0, (distance - segment.acc) / segment.len); result.push({ lat: segment.from.lat + (segment.to.lat - segment.from.lat) * local, lng: segment.from.lng + (segment.to.lng - segment.from.lng) * local }); break; } } return result; }
function lineFeature(line: RouteWaypoint[]) { const coordinates = line.map((p) => [p.lng, p.lat]); return { type: "Feature" as const, properties: {}, geometry: { type: "LineString" as const, coordinates: coordinates.length >= 2 ? coordinates : [coordinates[0], coordinates[0]] } }; }
function pointFeature(p: RouteWaypoint) { return { type: "Feature" as const, properties: {}, geometry: { type: "Point" as const, coordinates: [p.lng, p.lat] } }; }
function drawPill(ctx: CanvasRenderingContext2D, x: number, y: number, label: string) { ctx.font = "800 22px sans-serif"; const width = Math.max(78, ctx.measureText(label).width + 30); ctx.beginPath(); ctx.roundRect(x, y, width, 42, 21); ctx.fillStyle = "rgba(9,11,10,.9)"; ctx.fill(); ctx.strokeStyle = ROUTE_COLOR; ctx.lineWidth = 3; ctx.stroke(); ctx.fillStyle = ROUTE_COLOR; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText(label, x + width / 2, y + 21); }
function kilometerPoints(line: RouteWaypoint[]) { const { segments, total } = buildSegments(line), result: Array<{ point: RouteWaypoint; label: string }> = []; for (let km = 1; km <= Math.floor(total / 1000); km += 1) result.push({ point: pointAt(segments, total, km * 1000 / total), label: `${km} km` }); return result; }

function drawMapMarkers(ctx: CanvasRenderingContext2D, map: import("maplibre-gl").Map, points: RoutePoint[], kilometers: Array<{ point: RouteWaypoint; label: string }>) {
  ctx.save();
  for (const marker of kilometers) { const p = map.project([marker.point.lng, marker.point.lat]); if (p.x < -100 || p.x > WIDTH + 20 || p.y < -50 || p.y > HEIGHT + 20) continue; drawPill(ctx, p.x + 12, p.y - 21, marker.label); }
  for (const marker of points) { const p = map.project([marker.lng, marker.lat]); if (p.x < -150 || p.x > WIDTH + 50 || p.y < -100 || p.y > HEIGHT + 50) continue; const finish = marker.kind === "finish"; ctx.beginPath(); ctx.arc(p.x, p.y, 14, 0, Math.PI * 2); ctx.fillStyle = finish ? ROUTE_COLOR : "#fff"; ctx.fill(); ctx.strokeStyle = finish ? "#fff" : ROUTE_COLOR; ctx.lineWidth = 6; ctx.stroke(); ctx.font = "800 21px sans-serif"; const label = marker.label || (finish ? "Meta" : "Punto"), width = ctx.measureText(label).width + 28; ctx.beginPath(); ctx.roundRect(p.x - width / 2, p.y + 22, width, 40, 12); ctx.fillStyle = "rgba(9,11,10,.92)"; ctx.fill(); ctx.fillStyle = ROUTE_COLOR; ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText(label, p.x, p.y + 42); }
  ctx.restore();
}

function drawBranding(ctx: CanvasRenderingContext2D, options: RouteStoryOptions, logo: HTMLImageElement | null, dorsalia: HTMLImageElement | null) {
  const top = ctx.createLinearGradient(0, 0, 0, 340); top.addColorStop(0, "rgba(0,0,0,.88)"); top.addColorStop(1, "rgba(0,0,0,0)"); ctx.fillStyle = top; ctx.fillRect(0, 0, WIDTH, 340);
  const bottom = ctx.createLinearGradient(0, 1450, 0, HEIGHT); bottom.addColorStop(0, "rgba(0,0,0,0)"); bottom.addColorStop(.55, "rgba(0,0,0,.78)"); bottom.addColorStop(1, "#000"); ctx.fillStyle = bottom; ctx.fillRect(0, 1450, WIDTH, 470);
  if (logo) fitImage(ctx, logo, 62, 48, 250, 176); else { ctx.fillStyle = ROUTE_COLOR; ctx.font = "900 30px sans-serif"; ctx.fillText(options.eventName.toUpperCase().slice(0, 22), 64, 122); }
  ctx.textAlign = "right"; ctx.fillStyle = ROUTE_COLOR; ctx.font = "800 27px sans-serif"; ctx.fillText("RUTA", 1016, 92); ctx.fillStyle = "#fff"; ctx.font = "900 58px sans-serif"; ctx.fillText(options.routeName.toUpperCase().slice(0, 24), 1016, 156); if (options.distanceLabel) { ctx.fillStyle = "rgba(255,255,255,.72)"; ctx.font = "600 27px sans-serif"; ctx.fillText(options.distanceLabel, 1016, 200); }
  ctx.textAlign = "center"; ctx.fillStyle = "rgba(255,255,255,.62)"; ctx.font = "700 24px sans-serif"; ctx.fillText(options.eventName.toUpperCase().slice(0, 42), WIDTH / 2, 1640); if (dorsalia) fitImage(ctx, dorsalia, 350, 1698, 380, 78); else { ctx.fillStyle = "#fff"; ctx.font = "900 54px sans-serif"; ctx.fillText("DORSALIA", WIDTH / 2, 1760); } ctx.fillStyle = "#fff"; ctx.font = "600 27px sans-serif"; ctx.fillText("Ruta creada con Dorsalia", WIDTH / 2, 1825); ctx.fillStyle = ROUTE_COLOR; ctx.fillRect(440, 1862, 200, 5); ctx.textAlign = "left"; ctx.textBaseline = "alphabetic";
}

async function waitForMap(map: import("maplibre-gl").Map) { if (map.loaded()) return; await new Promise<void>((resolve, reject) => { const timer = window.setTimeout(() => reject(new Error("El mapa tardó demasiado en cargar.")), 15000); map.once("load", () => { window.clearTimeout(timer); resolve(); }); }); }

export async function createRouteStory(options: RouteStoryOptions): Promise<File> {
  if (!("MediaRecorder" in window)) throw new Error("Este navegador no permite crear videos."); if (options.line.length < 2) throw new Error("La ruta no tiene trazado suficiente.");
  const [{ Map: MapLibreMap, LngLatBounds, setWorkerUrl }, organizerLogo, dorsaliaLogo] = await Promise.all([import("maplibre-gl"), loadImage(options.organizerLogoUrl), loadImage("/branding/dorsalia-logo.svg")]);
  setWorkerUrl("https://cdn.jsdelivr.net/npm/maplibre-gl@6.9.0/dist/maplibre-gl-worker.mjs");
  const host = document.createElement("div"); Object.assign(host.style, { position: "fixed", left: "-12000px", top: "0", width: `${WIDTH}px`, height: `${HEIGHT}px`, pointerEvents: "none" }); document.body.appendChild(host);
  const style = await resolveOpenFreeMapStyle("dark");
  const map = new MapLibreMap({ container: host, style: style as never, center: [options.line[0].lng, options.line[0].lat], zoom: FOLLOW_ZOOM, attributionControl: false, fadeDuration: 0, interactive: false, canvasContextAttributes: { preserveDrawingBuffer: true } });
  try {
    await waitForMap(map); const full = lineFeature(options.line), start = options.line[0];
    map.addSource("ghost", { type: "geojson", data: full }); map.addLayer({ id: "ghost-line", type: "line", source: "ghost", layout: { "line-cap": "round", "line-join": "round" }, paint: { "line-color": "#3f3f46", "line-width": 8, "line-opacity": .9 } });
    map.addSource("progress", { type: "geojson", data: lineFeature([start, start]) }); map.addLayer({ id: "progress-line", type: "line", source: "progress", layout: { "line-cap": "round", "line-join": "round" }, paint: { "line-color": ROUTE_COLOR, "line-width": 10 } });
    map.addSource("runner", { type: "geojson", data: pointFeature(start) }); map.addLayer({ id: "runner-halo", type: "circle", source: "runner", paint: { "circle-radius": 14, "circle-color": "#000" } }); map.addLayer({ id: "runner-dot", type: "circle", source: "runner", paint: { "circle-radius": 10, "circle-color": ROUTE_COLOR } });
    const { segments, total } = buildSegments(options.line), kilometers = kilometerPoints(options.line); map.jumpTo({ center: [start.lng, start.lat], zoom: FOLLOW_ZOOM }); await new Promise((resolve) => window.setTimeout(resolve, 180));
    const canvas = document.createElement("canvas"); canvas.width = WIDTH; canvas.height = HEIGHT; const ctx = canvas.getContext("2d"); if (!ctx) throw new Error("No se pudo preparar el video."); const stream = canvas.captureStream(FPS);
    const mime = ["video/webm;codecs=vp9", "video/webm;codecs=vp8", "video/mp4"].find((type) => MediaRecorder.isTypeSupported(type)) || ""; const recorder = new MediaRecorder(stream, mime ? { mimeType: mime, videoBitsPerSecond: 8_000_000 } : { videoBitsPerSecond: 8_000_000 }); const chunks: Blob[] = []; recorder.ondataavailable = (event) => { if (event.data.size) chunks.push(event.data); }; const stopped = new Promise<void>((resolve, reject) => { recorder.onstop = () => resolve(); recorder.onerror = () => reject(new Error("No se pudo renderizar el video.")); });
    recorder.start(250); const started = performance.now(), camera = { lng: start.lng, lat: start.lat }; let overviewStarted = false;
    await new Promise<void>((resolve) => { const frame = (now: number) => { const elapsed = now - started; if (elapsed <= PLAY_MS) { const raw = Math.min(1, elapsed / PLAY_MS), eased = .5 - .5 * Math.cos(Math.PI * raw), position = pointAt(segments, total, eased); camera.lng += (position.lng - camera.lng) * CAM_FOLLOW; camera.lat += (position.lat - camera.lat) * CAM_FOLLOW; (map.getSource("progress") as import("maplibre-gl").GeoJSONSource).setData(lineFeature(prefix(options.line, segments, total, eased))); (map.getSource("runner") as import("maplibre-gl").GeoJSONSource).setData(pointFeature(position)); map.jumpTo({ center: [camera.lng, camera.lat], zoom: FOLLOW_ZOOM, bearing: 0, pitch: 0 }); } else if (!overviewStarted) { overviewStarted = true; const bounds = new LngLatBounds(); options.line.forEach((point) => bounds.extend([point.lng, point.lat])); map.fitBounds(bounds, { padding: { top: 300, bottom: 430, left: 90, right: 90 }, maxZoom: 15, duration: OVERVIEW_MS }); } map.triggerRepaint(); ctx.drawImage(map.getCanvas(), 0, 0, WIDTH, HEIGHT); drawMapMarkers(ctx, map, options.points || [], kilometers); drawBranding(ctx, options, organizerLogo, dorsaliaLogo); options.onProgress?.(Math.min(.94, elapsed / ROUTE_STORY_DURATION_MS * .94)); if (elapsed < ROUTE_STORY_DURATION_MS) requestAnimationFrame(frame); else resolve(); }; requestAnimationFrame(frame); });
    recorder.stop(); await stopped; stream.getTracks().forEach((track) => track.stop()); const recorded = new Blob(chunks, { type: recorder.mimeType || mime || "video/webm" }); options.onProgress?.(.96); const response = await fetch("/api/route-video/transcode", { method: "POST", headers: { "Content-Type": recorded.type || "application/octet-stream" }, body: recorded }); if (!response.ok) { const detail = await response.json().catch(() => null) as { error?: string } | null; throw new Error(detail?.error || "No se pudo finalizar el video para Instagram."); } const mp4 = await response.blob(); if (mp4.size < 1024) throw new Error("El servidor devolvió un video incompleto."); options.onProgress?.(1); return new File([mp4], `dorsalia-${fileSlug(options.routeName)}.mp4`, { type: "video/mp4", lastModified: Date.now() });
  } finally { map.remove(); host.remove(); }
}

export function downloadStory(file: File) { const url = URL.createObjectURL(file), anchor = document.createElement("a"); anchor.href = url; anchor.download = file.name; document.body.appendChild(anchor); anchor.click(); anchor.remove(); window.setTimeout(() => URL.revokeObjectURL(url), 3000); }
export async function shareStory(file: File, routeName: string) { const nav = navigator as Navigator & { canShare?: (data: ShareData) => boolean }; if (!nav.share || (nav.canShare && !nav.canShare({ files: [file] }))) return false; await nav.share({ files: [file], title: `Ruta ${routeName}`, text: "Ruta creada con Dorsalia" }); return true; }

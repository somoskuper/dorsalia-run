import type { RouteWaypoint } from "@/lib/routeMap";

export const ROUTE_STORY_DURATION_MS = 20000;
const WIDTH = 1080;
const HEIGHT = 1920;
const FPS = 30;

export type RouteStoryOptions = {
  line: RouteWaypoint[];
  routeName: string;
  distanceLabel?: string;
  eventName: string;
  organizerLogoUrl?: string | null;
  onProgress?: (progress: number) => void;
};

function fileSlug(value: string) {
  return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase()
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "ruta";
}

function loadImage(src?: string | null): Promise<HTMLImageElement | null> {
  if (!src) return Promise.resolve(null);
  return new Promise((resolve) => {
    const image = new Image();
    image.crossOrigin = "anonymous";
    image.onload = () => resolve(image);
    image.onerror = () => resolve(null);
    image.src = src;
  });
}

function fitImage(ctx: CanvasRenderingContext2D, image: HTMLImageElement, x: number, y: number, w: number, h: number) {
  const scale = Math.min(w / image.naturalWidth, h / image.naturalHeight);
  const dw = image.naturalWidth * scale;
  const dh = image.naturalHeight * scale;
  ctx.drawImage(image, x + (w - dw) / 2, y + (h - dh) / 2, dw, dh);
}

function project(line: RouteWaypoint[]) {
  const avgLat = line.reduce((sum, point) => sum + point.lat, 0) / line.length;
  const cos = Math.cos(avgLat * Math.PI / 180);
  const raw = line.map((point) => ({ x: point.lng * cos, y: -point.lat }));
  const minX = Math.min(...raw.map((point) => point.x));
  const maxX = Math.max(...raw.map((point) => point.x));
  const minY = Math.min(...raw.map((point) => point.y));
  const maxY = Math.max(...raw.map((point) => point.y));
  const area = { x: 100, y: 390, width: 880, height: 1040 };
  const scale = Math.min(
    area.width / Math.max(maxX - minX, 0.000001),
    area.height / Math.max(maxY - minY, 0.000001),
  );
  const width = (maxX - minX) * scale;
  const height = (maxY - minY) * scale;
  return raw.map((point) => ({
    x: area.x + (area.width - width) / 2 + (point.x - minX) * scale,
    y: area.y + (area.height - height) / 2 + (point.y - minY) * scale,
  }));
}

function strokeProgress(ctx: CanvasRenderingContext2D, points: Array<{ x: number; y: number }>, progress: number) {
  const lengths: number[] = [];
  let total = 0;
  for (let i = 1; i < points.length; i += 1) {
    const length = Math.hypot(points[i].x - points[i - 1].x, points[i].y - points[i - 1].y);
    lengths.push(length);
    total += length;
  }
  let remaining = total * progress;
  ctx.beginPath();
  ctx.moveTo(points[0].x, points[0].y);
  for (let i = 1; i < points.length && remaining > 0; i += 1) {
    const length = lengths[i - 1];
    const ratio = Math.min(1, remaining / Math.max(length, 0.001));
    const from = points[i - 1];
    const to = points[i];
    ctx.lineTo(from.x + (to.x - from.x) * ratio, from.y + (to.y - from.y) * ratio);
    remaining -= length;
  }
  ctx.stroke();
}

function drawFrame(
  ctx: CanvasRenderingContext2D,
  options: RouteStoryOptions,
  points: Array<{ x: number; y: number }>,
  organizerLogo: HTMLImageElement | null,
  dorsaliaLogo: HTMLImageElement | null,
  elapsed: number,
) {
  const raw = Math.min(1, elapsed / ROUTE_STORY_DURATION_MS);
  const progress = 0.5 - 0.5 * Math.cos(Math.PI * raw);
  const background = ctx.createLinearGradient(0, 0, WIDTH, HEIGHT);
  background.addColorStop(0, "#171a18");
  background.addColorStop(0.58, "#090b0a");
  background.addColorStop(1, "#000000");
  ctx.fillStyle = background;
  ctx.fillRect(0, 0, WIDTH, HEIGHT);

  ctx.save();
  ctx.globalAlpha = 0.13;
  ctx.strokeStyle = "#aab3ac";
  ctx.lineWidth = 2;
  for (let x = -HEIGHT; x < WIDTH + HEIGHT; x += 92) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x + HEIGHT, HEIGHT); ctx.stroke();
  }
  ctx.restore();

  ctx.fillStyle = "rgba(203,255,0,.08)";
  ctx.beginPath(); ctx.arc(855, 705, 560, 0, Math.PI * 2); ctx.fill();

  if (organizerLogo) {
    ctx.beginPath(); ctx.roundRect(64, 64, 224, 154, 32);
    ctx.fillStyle = "rgba(255,255,255,.96)"; ctx.fill();
    fitImage(ctx, organizerLogo, 88, 88, 176, 106);
  } else {
    ctx.fillStyle = "#cbff00"; ctx.font = "800 29px sans-serif";
    ctx.fillText(options.eventName.toUpperCase().slice(0, 22), 66, 128);
  }

  ctx.textAlign = "right";
  ctx.fillStyle = "#cbff00"; ctx.font = "800 28px sans-serif"; ctx.fillText("RUTA", 1016, 98);
  ctx.fillStyle = "#fff"; ctx.font = "900 58px sans-serif"; ctx.fillText(options.routeName.toUpperCase().slice(0, 24), 1016, 160);
  if (options.distanceLabel) {
    ctx.fillStyle = "rgba(255,255,255,.68)"; ctx.font = "600 26px sans-serif"; ctx.fillText(options.distanceLabel, 1016, 202);
  }
  ctx.textAlign = "left";

  ctx.save();
  ctx.lineCap = "round"; ctx.lineJoin = "round";
  ctx.strokeStyle = "rgba(0,0,0,.88)"; ctx.lineWidth = 34; strokeProgress(ctx, points, progress);
  ctx.shadowColor = "rgba(203,255,0,.8)"; ctx.shadowBlur = 32;
  ctx.strokeStyle = "#cbff00"; ctx.lineWidth = 18; strokeProgress(ctx, points, progress);
  ctx.restore();

  const start = points[0];
  ctx.beginPath(); ctx.arc(start.x, start.y, 17, 0, Math.PI * 2); ctx.fillStyle = "#fff"; ctx.fill();
  ctx.strokeStyle = "#cbff00"; ctx.lineWidth = 9; ctx.stroke();
  if (progress >= 0.998) {
    const finish = points[points.length - 1];
    ctx.beginPath(); ctx.arc(finish.x, finish.y, 20, 0, Math.PI * 2); ctx.fillStyle = "#cbff00"; ctx.fill();
    ctx.strokeStyle = "#fff"; ctx.lineWidth = 9; ctx.stroke();
  }

  const footer = ctx.createLinearGradient(0, 1450, 0, HEIGHT);
  footer.addColorStop(0, "rgba(0,0,0,0)"); footer.addColorStop(0.6, "rgba(0,0,0,.85)"); footer.addColorStop(1, "#000");
  ctx.fillStyle = footer; ctx.fillRect(0, 1400, WIDTH, 520);
  ctx.textAlign = "center";
  ctx.fillStyle = "rgba(255,255,255,.6)"; ctx.font = "700 24px sans-serif";
  ctx.fillText(options.eventName.toUpperCase().slice(0, 42), WIDTH / 2, 1625);
  if (dorsaliaLogo) fitImage(ctx, dorsaliaLogo, 350, 1688, 380, 78);
  else { ctx.fillStyle = "#fff"; ctx.font = "900 54px sans-serif"; ctx.fillText("DORSALIA", WIDTH / 2, 1750); }
  ctx.fillStyle = "#fff"; ctx.font = "600 27px sans-serif"; ctx.fillText("Ruta creada con Dorsalia", WIDTH / 2, 1817);
  ctx.fillStyle = "#cbff00"; ctx.fillRect(440, 1854, 200, 5);
  ctx.textAlign = "left";
}

export async function createRouteStory(options: RouteStoryOptions): Promise<File> {
  if (!("MediaRecorder" in window)) throw new Error("Este navegador no permite crear videos.");
  if (options.line.length < 2) throw new Error("La ruta no tiene trazado suficiente.");
  const canvas = document.createElement("canvas");
  canvas.width = WIDTH; canvas.height = HEIGHT;
  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("No se pudo preparar el video.");
  const [organizerLogo, dorsaliaLogo] = await Promise.all([
    loadImage(options.organizerLogoUrl), loadImage("/branding/dorsalia-logo.svg"),
  ]);
  const points = project(options.line);
  const candidates = ["video/mp4;codecs=h264", "video/mp4", "video/webm;codecs=vp9", "video/webm;codecs=vp8"];
  const mimeType = candidates.find((type) => MediaRecorder.isTypeSupported(type)) || "";
  const stream = canvas.captureStream(FPS);
  const recorder = new MediaRecorder(stream, mimeType ? { mimeType, videoBitsPerSecond: 8_000_000 } : { videoBitsPerSecond: 8_000_000 });
  const chunks: Blob[] = [];
  recorder.ondataavailable = (event) => { if (event.data.size) chunks.push(event.data); };
  const stopped = new Promise<void>((resolve, reject) => {
    recorder.onstop = () => resolve();
    recorder.onerror = () => reject(new Error("No se pudo renderizar el video."));
  });
  recorder.start(250);
  const started = performance.now();
  await new Promise<void>((resolve) => {
    const frame = (now: number) => {
      const elapsed = now - started;
      drawFrame(ctx, options, points, organizerLogo, dorsaliaLogo, elapsed);
      options.onProgress?.(Math.min(1, elapsed / ROUTE_STORY_DURATION_MS));
      if (elapsed < ROUTE_STORY_DURATION_MS) requestAnimationFrame(frame); else resolve();
    };
    requestAnimationFrame(frame);
  });
  recorder.stop(); await stopped; stream.getTracks().forEach((track) => track.stop());
  const type = recorder.mimeType || mimeType || "video/webm";
  const recorded = new Blob(chunks, { type });
  options.onProgress?.(0.96);
  const response = await fetch("/api/route-video/transcode", {
    method: "POST",
    headers: { "Content-Type": type || "application/octet-stream" },
    body: recorded,
  });
  if (!response.ok) {
    const detail = await response.json().catch(() => null) as { error?: string } | null;
    throw new Error(detail?.error || "No se pudo finalizar el video para Instagram.");
  }
  const mp4 = await response.blob();
  if (mp4.size < 1024 || !mp4.type.includes("video/mp4")) {
    throw new Error("El servidor devolvió un video incompleto.");
  }
  options.onProgress?.(1);
  return new File([mp4], `dorsalia-${fileSlug(options.routeName)}.mp4`, {
    type: "video/mp4",
    lastModified: Date.now(),
  });
}

export function downloadStory(file: File) {
  const url = URL.createObjectURL(file);
  const anchor = document.createElement("a"); anchor.href = url; anchor.download = file.name;
  document.body.appendChild(anchor); anchor.click(); anchor.remove();
  window.setTimeout(() => URL.revokeObjectURL(url), 3000);
}

export async function shareStory(file: File, routeName: string) {
  const nav = navigator as Navigator & { canShare?: (data: ShareData) => boolean };
  if (!nav.share || (nav.canShare && !nav.canShare({ files: [file] }))) return false;
  await nav.share({ files: [file], title: `Ruta ${routeName}`, text: "Ruta creada con Dorsalia" });
  return true;
}

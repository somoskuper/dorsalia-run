# Copy this file to .env.local. Never commit .env.local.
#
# The values marked "secure bundle" are supplied separately from Git.

# Dorsalia API / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://portal.dorsalia.run
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PORTAL_URL=https://portal.dorsalia.run

# Local URLs and cookie scope
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=localhost
NEXT_PUBLIC_EDITOR_URL=https://editor.dorsalia.run

# Map tiles (secure bundle)
NEXT_PUBLIC_CARTO_API_KEY=

# Server-side API endpoints used by the marketplace
PUBLIC_EVENTS_API=https://portal.dorsalia.run/sites/v1/public-events
SITE_CONFIG_API=https://portal.dorsalia.run/sites/v1/public-config

# Optional local directory for cached route videos
# ROUTE_VIDEO_DIR=/absolute/path/to/route-videos

# Server-only. Used to email the password-change code. Never commit real values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dorsalia <contacto@dorsalia.run>
